    {
      "name": "III. Field Experience Requirement",
      "requirement": {
        "type": "text",
        "text": "Global Health Field Experience: minimum one hundred hours distributed over no more than three programs, at a research, service, or clinical site in the United States or abroad, approved by the advisory committee. May be noncredit or credit bearing. Upon approval by petition, a student may enroll in a maximum of two Independent Study (GLBH 199) or Directed Group Study (GLBH 198) courses; this credit will count as an elective toward the major."
      }
    },
