status":"active"},{"type":"course","code":"USP 188","status":"active"},{"type":"course","code":"VIS 102","status":"active"},{"type":"course","code":"VIS 126AN","status":"active"},{"type":"course","code":"VIS 126BN","status":"active"},{"type":"course","code":"VIS 126C","status":"inactive"},{"type":"course","code":"VIS 126D","status":"inactive"},{"type":"course","code":"VIS 126Q","status":"active"},{"type":"course","code":"SOCI 117","status":"active"},{"type":"course","code":"LTSP 150A","status":"active"},{"type":"course","code":"ETHN 105","status":"active"}],"count":9,"notes":"Nine upper-division elective courses chosen from the approved list of courses. Students may take no more than three upper-division courses in any one department."}}],"narrative":["All courses counting toward the major must be taken for a letter grade.","Students may take no more than three upper-division courses in any one department.","Students can only overlap a maximum of two courses (eight units) between their major and minor.","Maintain a 2.0 GPA.","Students may petition to receive credit for relevant courses not listed in the catalog. All study abroad courses must be petitioned.","The CLS major requires fifty-six units of study to complete the program (fourteen four-credit courses)."],"overrides_applied":[]},"nodes":[{"id":"AAS 170","title":"Legacies of Research on Disenfranchised Communities","units":"4","offered":["Spring"],"level":"upper","status":"active","in_major":true,"role":"choice","groups":["Upper-division core courses"],"column":1,"prereq_text":"","requires":null,"ambiguous":false,"description":"Students will learn about the historic and current legacies of scientific research and the convergence(s) between science and society as a mechanism for colonization and imperialism.","url":"https://catalog.ucsd.edu/courses/AASM.html#aasm170"},{"id":"CLX 1","title":"Cornerstone of Chicanx and Latinx Studies","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Lower-division courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"This course focuses on the formation of the discipline of Chicanx and Latinx studies through an engagement with key historical events, seminal texts, debates, and scholarship about the Chicanx and Latinx experience in the U.S. and beyond. Students will be introduced to major theoretical frameworks and methodological approaches to research by and about the Chicanx and Latinx population.","url":"https://catalog.ucsd.edu/courses/CLS.html#clx1"},{"id":"CLX 2","title":"Chicanx and Latinx Studies—Gender and Sexuality","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Lower-division courses: One additional course"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"This course will explore the discipline of Chicanx and Latinx studies with gender and sexuality as major categories of analysis and as embodied experiences. Students will be introduced to the main currents of the field of study with an emphasis on gender and sexuality and their intersection with socioeconomic and political issues of concern.","url":"https://catalog.ucsd.edu/courses/CLS.html#clx2"},{"id":"CLX 3","title":"Chicanx and Latinx Studies—Special Topics","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Lower-division courses: One additional course"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"This course will draw from a range of special topics that include but are not limited to Chicanx and Latinx policy and social structures; arts and culture; public health; Mexican/Latinx philosophy; data and technology; ethics and leadership; social processes and critical praxis; biotech; social justice research; borders, etc. This course will provide an introduction to specialized topics in CLS that students can build on in their upper-division course work.","url":"https://catalog.ucsd.edu/courses/CLS.html#clx3"},{"id":"CLX 101","title":"Approaches to Research in Chicanx and Latinx Studies","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"choice","groups":["Upper-division core courses"],"column":1,"prereq_text":"","requires":null,"ambiguous":false,"description":"This course builds on CLX 1 and provides students with an immersive experience with Chicanx and Latinx theory and research methodologies. Students will become equipped to conduct ethical research, formulate equitable relationships with local partners, and foster strategies for community outreach. These skills will serve as the basis for developing potential research projects that engage the Chicanx and Latinx experience. CLX 101 is a prerequisite for CLX 102 and CLX 103.","url":"https://catalog.ucsd.edu/courses/CLS.html#clx101"},{"id":"CLX 102","title":"Research Practicum in Chicanx and Latinx Studies","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Upper-division core courses"],"column":2,"prereq_text":"CLX 101 or department approval.","requires":{"type":"or","items":[{"type":"course","code":"CLX 101","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"department approval"}]},"ambiguous":false,"description":"This course explores Chicanx and Latinx experiences in San Diego and the greater border region through community-engaged research. Building on the foundation provided by CLX 101, students will establish relationships with community partners, conduct community-engaged research, and collaborate with their peers in the classroom. Faculty will support and guide students throughout their field research process.","url":"https://catalog.ucsd.edu/courses/CLS.html#clx102"},{"id":"CLX 103","title":"Capstone in Chicanx and Latinx Studies","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Upper-division core courses"],"column":3,"prereq_text":"CLX 102 or department approval.","requires":{"type":"or","items":[{"type":"course","code":"CLX 102","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"department approval"}]},"ambiguous":false,"description":"This course is a culmination of the upper-division core courses in CLS. Students will apply the knowledge acquired from CLX core courses, cultivate team building and leadership skills, and produce a community-engaged research project. Students will be required to develop a final project that could consist of a written essay, art project, and/or performance. The course will conclude with a student-led showcase that will include the class and community partners in celebration of their collective efforts.","url":"https://catalog.ucsd.edu/courses/CLS.html#clx103"},{"id":"ETHN 30","title":"Introduction to Chicanx and Latinx Studies","units":"4","offered":["Winter","Spring"],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Lower-division courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Introduction to Chicanx/Latinx/Hispanic history, culture, and activism with focus on race and class differences within US Latinx cultures and in relation to other groups; gender, sexuality, and colonialism; and new ways of worldmaking within and across these categories.","url":"https://catalog.ucsd.edu/courses/ETHN.html#ethn30"},{"id":"HILD 7C","title":"Race and Ethnicity in the United States","units":"4","offered":["Fall","Spring","Summer"],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Lower-division courses: One additional course"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lectures and discussions surveying the topics of race, slavery, demographic patterns, ethnic variety, rural and urban life in the United States, with special focus on European, Asian, and Mexican immigration.","url":"https://catalog.ucsd.edu/courses/HIST.html#hild7c"}],"edges":[{"from":"CLX 101","to":"CLX 102","type":"alternative","group":"CLX 102/or1","concurrent":false,"min_grade":null},{"from":"CLX 102","to":"CLX 103","type":"alternative","group":"CLX 103/or1","concurrent":false,"min_grade":null}],"pools":[{"id":"pool-1","label":"Upper-division electives","section":"Upper-division electives","rule":"at least 9 courses","list_name":null,"courses":["ANAR 159","ANSC 104","ANSC 117","ANSC 135","AAS 170","CGS 127","CGS 137","CGS 187","COMM 111B","COMM 140","COMM 155","COMM 183","ECON 162","EDS 113","EDS 117","EDS 125","ETHN 108","ETHN 113","ETHN 116","ETHN 118","ETHN 119","ETHN 129","ETHN 130","ETHN 131","ETHN 132","ETHN 133","ETHN 134","ETHN 135A","ETHN 135B","ETHN 137","ETHN 138","ETHN 139","ETHN 143","ETHN 146A","ETHN 153","ETHN 154","ETHN 168","ETHN 180","ETHN 187","GLBH 108","GLBH 114","HILA 100","HILA 101","HILA 102","HILA 114","HILA 115","HILA 118","HILA 119","HILA 122","HILA 124A","HILA 131","HILA 132","HILA 161","HILA 167","HILA 168","HILA 169","HIUS 102","HIUS 105","HIUS 113","HIUS 136","HIUS 146","HIUS 155","HIUS 158","HIUS 159","HIUS 167","HIUS 168","HIUS 180","HITO 156","LIGN 143","LIGN 152","LIGN 178","LTAM 100","LTAM 105","LTAM 107","LTAM 108","LTAM 109","LTAM 110","LTEN 169","LTEN 171","LTEN 178","LTEN 180","LTSP 100A","LTSP 100F","LTSP 110","LTSP 116","LTSP 123","LTSP 124","LTSP 126","LTSP 128","LTSP 130A","LTSP 130B","LTSP 133","LTSP 135A","LTSP 135B","LTSP 136","LTSP 137","LTSP 138","LTSP 140","LTSP 142","LTSP 150B","LTSP 151","LTSP 154","LTSP 162","LTSP 166","LTSP 169","LTSP 171","LTSP 172","LTSP 175","LTSP 177","PHIL 155","PHIL 156","POLI 100H","POLI 100J","POLI 105A","POLI 134J","POLI 146A","POLI 150A","TDAC 120","TDHT 108","TDHT 110","TDHT 111","TDMV 142","TDMV 146","USP 104","USP 135","USP 162","USP 176","USP 188","VIS 102","VIS 126AN","VIS 126BN","VIS 126C","VIS 126D","VIS 126Q","SOCI 117","LTSP 150A","ETHN 105"]}],"loops