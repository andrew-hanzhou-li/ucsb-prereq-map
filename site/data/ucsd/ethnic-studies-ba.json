,"code":"ETHN 178R","status":"active"},{"type":"course","code":"ETHN 179","status":"active"},{"type":"course","code":"ETHN 180","status":"active"},{"type":"course","code":"ETHN 182","status":"active"},{"type":"course","code":"ETHN 183","status":"active"},{"type":"course","code":"ETHN 184","status":"active"},{"type":"course","code":"ETHN 185","status":"active"},{"type":"course","code":"ETHN 185A","status":"active"},{"type":"course","code":"ETHN 186","status":"active"},{"type":"course","code":"ETHN 187","status":"active"},{"type":"course","code":"ETHN 188","status":"active"},{"type":"course","code":"ETHN 189","status":"active"},{"type":"course","code":"ETHN 190","status":"inactive"},{"type":"course","code":"ETHN 197","status":"active"},{"type":"course","code":"ETHN 198","status":"active"},{"type":"course","code":"ETHN 199","status":"active"},{"type":"course","code":"ETHN 100H","status":"active"},{"type":"course","code":"ETHN 196H","status":"active"},{"type":"text","text":"Up to three upper-division courses from another UC San Diego department, a UC San Diego approved study abroad program, or another UC campus, by petition, if appropriate to the ethnic studies major"}],"count":10,"label":"Upper-division ethnic studies electives","notes":"Only a total of two courses from the special studies (ETHN 197, 198, 199) will be counted in fulfillment of the elective requirement. ETHN 189 may be repeated three times for credit toward major requirements when topics vary. ETHN 100H and ETHN 196H (honors) count toward the ten electives."}]}}],"narrative":["To satisfy the requirements for the major, lower- and upper-division courses must be completed with a P, C-, or better grade.","Except for independent study course electives (ETHN 197, 198, or 199) which are always taken with a Pass/Not Pass grade option, students majoring in ethnic studies may take up to two courses, either lower or upper division, with a Pass/Not Pass option.","A minimum of thirteen four-unit upper-division courses in the Department of Ethnic Studies must be completed.","Ethnic studies majors, including students who are double majors, may petition up to three upper-division courses to fulfill major requirements (course taken from another UC San Diego department, a UC San Diego approved study abroad program, or another UC campus, and appropriate to the ethnic studies major).","Students who complete ETHN 100H and ETHN 196H will receive credit toward the total number of ten upper-division electives required for the ethnic studies major."],"overrides_applied":[]},"nodes":[{"id":"ETHN 1","title":"Introduction to Ethnic Studies: Land and Labor","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Lower-division requirements: Introduction to Ethnic Studies"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"This course examines key historical events and debates in the field that center around land and labor, including disputes about territory and natural resources, slavery and other forms of unfree labor, labor migration and recruitment, and US and transnational borders. Students may not receive credit for both ETHN 1R and ETHN 1.","url":"https://catalog.ucsd.edu/courses/ETHN.html#ethn1"},{"id":"ETHN 2","title":"Introduction to Ethnic Studies: Circulations of Difference","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Lower-division requirements: Introduction to Ethnic Studies"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Focusing on historical and contemporary migration and the circulation of commodities, knowledge, bodies, and culture, this course looks at how racial formation is shaped and contested by such movements within national and transnational contexts. Students may not receive credit for both ETHN 2R and ETHN 2.","url":"https://catalog.ucsd.edu/courses/ETHN.html#ethn2"},{"id":"ETHN 3","title":"Introduction to Ethnic Studies: Making Culture","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Lower-division requirements: Introduction to Ethnic Studies"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Through examining the historical and contemporary politics of representation in both popular and community-focused media, film, art, music, and literature, this course tracks racial formation through studying the sphere of cultural production, consumption, and contestation. Students may not receive credit for both ETHN 1C and ETHN 3.","url":"https://catalog.ucsd.edu/courses/ETHN.html#ethn3"},{"id":"ETHN 100A","title":"Ethnic Studies: Theoretical Approaches","units":"4","offered":["Fall"],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Upper-division requirements"],"column":1,"prereq_text":"ETHN 1 or ETHN 2 or ETHN 3, ethnic studies majors or minors, or consent of instructor.","requires":{"type":"or","items":[{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"ETHN 1","concurrent":false,"min_grade":null},{"type":"course","code":"ETHN 2","concurrent":false,"min_grade":null},{"type":"course","code":"ETHN 3","concurrent":false,"min_grade":null}]},{"type":"condition","kind":"other","text":"ethnic studies majors"}]},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":true,"description":"An advanced survey of key issues, themes, and debates in the field of critical ethnic studies focusing on the connection between race and social structures. Students will use diverse theoretical frameworks to identify and interpret contemporary and historical social problems.","url":"https://catalog.ucsd.edu/courses/ETHN.html#ethn100a"},{"id":"ETHN 100B","title":"Interdisciplinary Methodologies","units":"4","offered":["Winter"],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Upper-division requirements"],"column":2,"prereq_text":"ETHN 100A, ethnic studies major or minor, or consent of instructor.","requires":{"type":"or","items":[{"type":"and","items":[{"type":"condition","kind":"restriction","text":"and ethnic studies major or minor"},{"type":"course","code":"ETHN 100A","concurrent":false,"min_grade":null}]},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"An introduction to interdisciplinary research methodologies in critical ethnic studies. By developing a critical analysis of the politics of knowledge production, students will learn to identify different methodological approaches in the field and to evaluate their use in practical application.","url":"https://catalog.ucsd.edu/courses/ETHN.html#ethn100b"},{"id":"ETHN 100C","title":"Social Justice Praxis","units":"4","offered":["Spring"],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Upper-division requirements"],"column":3,"prereq_text":"ETHN 100A and ETHN 100B, ethnic studies major or minor, or consent of instructor.","requires":{"type":"or","items":[{"type":"and","items":[{"type":"course","code":"ETHN 100A","concurrent":false,"min_grade":null},{"type":"condition","kind":"restriction","text":"and ethnic studies major or minor"},{"type":"course","code":"ETHN 100B","concurrent":false,"min_grade":null}]},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"An intensive capstone experience for ethnic studies majors, this course combines an advanced exploration of praxis-based approaches to social justice with practicum-based independent campus, community, creative, or research projects.","url":"https://catalog.ucsd.edu/courses/ETHN.html#ethn100c"}],"edges":[{"from":"ETHN 1","to":"ETHN 100A","type":"alternative","group":"ETHN 100A/or2","concurrent":false,"min_grade":null},{"from":"ETHN 2","to":"ETHN 100A","type":"alternative","group":"ETHN 100A/or2","concurrent":false,"min_gra