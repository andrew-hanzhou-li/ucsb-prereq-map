{"major":{"id":"UCLA-LINGUISTICSANDCOMPUTERSCIENCEBA","name":"Linguistics and Computer Science BA","kind":"major","catalog_year":"2026-27","source":"https://catalog.registrar.ucla.edu/major/2026/LINGUISTICSANDCOMPUTERSCIENCEBA","sections":[{"name":"Preparation for the Major","requirement":{"type":"all","items":[{"type":"course","code":"LING 20","status":"inactive"},{"type":"course","code":"COM SCI 31","status":"active"},{"type":"course","code":"COM SCI 32","status":"active"},{"type":"course","code":"COM SCI 33","status":"active"},{"type":"course","code":"COM SCI 35L","status":"active"},{"type":"course","code":"MATH 31A","status":"inactive"},{"type":"course","code":"MATH 31AL","status":"inactive"},{"type":"course","code":"MATH 31B","status":"inactive"},{"type":"course","code":"MATH 61","status":"inactive"},{"type":"course","code":"MATH 70","status":"inactive"},{"type":"text","text":"Completion of the third term in one foreign language."}],"label":"Preparation for the Major"}},{"name":"Honors Program","requirement":{"type":"all","items":[{"type":"all","items":[{"type":"course","code":"LING 198A","status":"inactive"},{"type":"course","code":"LING 198B","status":"inactive"}],"label":"Linguistics 198A and 198B"},{"type":"all","items":[{"type":"course","code":"LING 199","status":"inactive"}],"label":"Linguistics 199"}],"label":"Honors Program","notes":"Departmental honors are awarded at graduation to those students who have a grade-point average of 3.6 or better in their junior and senior years and who have received a grade of A in Linguistics 198A and 198B or in 199. Qualified students may be proposed by any member of the faculty to the faculty as a whole for the award of highest honors on the basis of a piece of research in linguistics completed at UCLA."}},{"name":"The Major","requirement":{"type":"all","items":[{"type":"all","items":[{"type":"choose","items":[{"type":"course","code":"LING 102","status":"inactive"},{"type":"course","code":"LING 103","status":"inactive"