verrides_applied":[]},"nodes":[{"id":"COM SCI 31","title":"Introduction to Computer Science I","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Introduction to computer science via theory, applications, and programming. Basic data types, operators and control structures. Input/output. Procedural and data abstraction. Introduction to object-oriented software development. Functions, recursion. Arrays, strings, pointers. Abstract data types, object-oriented programming. Examples and exercises from computer science theory and applications. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI31"},{"id":"COM SCI 32","title":"Introduction to Computer Science II","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"course 31","requires":{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Object-oriented software development. Abstract data type definition and use. Overloading, inheritance, polymorphism. Object-oriented view of data structures: stacks, queues, lists. Algorithm analysis. Trees, graphs, and associated algorithms. Searching and sorting. Case studies and exercises from computer science applications. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI32"},{"id":"COM SCI 33","title":"Introduction to Computer Organization","units":"5","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":2,"prereq_text":"course 32","requires":{"type":"course","code":"COM SCI 32","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, nine hours. Introductory course on computer architecture, assembly language, and operating systems fundamentals. Number systems, machine language, and assembly language. Procedure calls, stacks, interrupts, and traps. Assemblers, linkers, and loaders. Operating systems concepts: processes and process management, input/output (I/O) programming, memory management, file systems. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI33"},{"id":"COM SCI 35L","title":"Software Construction","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":2,"prereq_text":"courses 31, 32","requires":{"type":"and","items":[{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":null},{"type":"course","code":"COM SCI 32","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Fundamentals of tools and environments for software construction projects, particularly open-source platforms used in upper-division computer science courses. Software practice through collaborative student project. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI35L"},{"id":"COM SCI 131","title":"Programming Languages","units":"4","offered":["Fall"],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Computer Science"],"column":3,"prereq_text":"courses 33, 35L","requires":{"type":"and","items":[{"type":"course","code":"COM SCI 33","concurrent":false,"min_grade":null},{"type":"course","code":"COM SCI 35L","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, four hours; laboratory, two hours; outside study, six hours. Basic concepts in design and use of programming languages, including abstraction, modularity, control mechanisms, types, declarations, syntax, and semantics. Study of several different language paradigms, including functional, object-oriented, and logic programming. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI131"},{"id":"COM SCI 132","title":"Compiler Construction","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"choice","groups":["The Major: Computer Science 132 or 161"],"column":4,"prereq_text":"course 131","requires":{"type":"course","code":"COM SCI 131","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Compiler structure; lexical and syntactic analysis; semantic analysis and code generation; theory of parsing. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI132"},{"id":"COM SCI 161","title":"Fundamentals of Artificial Intelligence","units":"4","offered":["Fall"],"level":"upper","status":"active","in_major":true,"role":"choice","groups":["The Major: Computer Science 132 or 161"],"column":3,"prereq_text":"course 180","requires":{"type":"course","code":"COM SCI 180","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, four hours; laboratory, two hours; outside study, six hours. Introduction to fundamental problem solving and knowledge representation paradigms of artificial intelligence. Introduction to Lisp with regular programming assignments. State-space and problem reduction methods, brute-force and heuristic search, planning techniques, two-player games. Knowledge structures including predicate logic, production systems, semantic nets and primitives, frames, scripts. Special topics in natural language processing, expert systems, vision, and parallel architectures. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI161"},{"id":"COM SCI 180","title":"Introduction to Algorithms and Complexity","units":"4","offered":["Fall"],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Computer Science"],"column":2,"prereq_text":"course 32, Mathematics 61","requires":{"type":"and","items":[{"type":"course","code":"COM SCI 32","concurrent":false,"min_grade":null},{"type":"course","code":"MATH 61","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Designed for junior/senior Computer Science majors. Introduction to design and analysis of algorithms. Design techniques: divide-and-conquer, greedy method, dynamic programming; selection of prototypical algorithms; choice of data structures and representations; complexity measures: time, space, upper, lower bounds, asymptotic complexity; NP-completeness. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI180"},{"id":"COM SCI 181","title":"Theory of Computing","units":"4","offered":["Fall"],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Computer Science"],"column":3,"prereq_text":"course 180","requires":{"type":"course","code":"COM SCI 180","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Designed for junior/senior Computer Science majors. Finite state machines, context-free languages, and pushdown automata. Closure properties and pumping lemmas. Turing machines, undecidability. Introduction to computability. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI181"},{"id":"LING 20","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LING 102","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"choice","groups":["The Major: