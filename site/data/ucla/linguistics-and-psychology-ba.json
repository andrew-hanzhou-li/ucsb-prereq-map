code":"PSYCH 133B","status":"inactive"},{"type":"course","code":"PSYCH 133C","status":"inactive"},{"type":"course","code":"PSYCH 133E","status":"inactive"},{"type":"course","code":"PSYCH 133F","status":"inactive"},{"type":"course","code":"PSYCH 186A","status":"inactive"},{"type":"course","code":"PSYCH 186B","status":"inactive"}],"count":2,"label":"Psychology Electives","notes":"Select two courses from:"}],"label":"Psychology"}],"label":"The Major"}},{"name":"Preparation for the Major","requirement":{"type":"all","items":[{"type":"course","code":"LING 20","status":"inactive"},{"type":"course","code":"PSYCH 10","status":"inactive"},{"type":"course","code":"PSYCH 85","status":"inactive"},{"type":"course","code":"PSYCH 100A","status":"inactive"},{"type":"course","code":"PSYCH 100B","status":"inactive"},{"type":"text","text":"Complete the equivalent to the sixth level of one foreign language or the equivalent to the third level of two different foreign languages."},{"type":"all","items":[{"type":"course","code":"COMPTNG 10A","status":"active"}],"label":"Recommended","notes":"The following course is strongly recommended:"}],"label":"Preparation for the Major"}},{"name":"Computing Specialization","requirement":{"type":"all","items":[{"type":"choose","items":[{"type":"all","items":[{"type":"course","code":"COMPTNG 10A","status":"active"},{"type":"course","code":"COMPTNG 10B","status":"active"},{"type":"course","code":"COMPTNG 10C","status":"active"}],"label":"Program in Computing"},{"type":"all","items":[{"type":"course","code":"COM SCI 31","status":"active"},{"type":"course","code":"COM SCI 32","status":"active"}],"label":"Computer Science"}],"count":1,"label":"Introduction to Computing","notes":"Select one series from:"},{"type":"all","items":[{"type":"course","code":"LING 185A","status":"inactive"},{"type":"course","code":"MATH 61","status":"inactive"}],"label":"Linguistics 185A and Mathematics 61"},{"type":"choose","items":[{"type":"course","code":"LING C104","status":"inactive"},{"type":"course","code":"LING 127","status":"inactive"},{"type":"course","code":"LING 132","status":"inactive"},{"type":"course","code":"LING 165A","status":"inactive"},{"type":"course","code":"LING 165B","status":"inactive"},{"type":"course","code":"LING 165C","status":"inactive"},{"type":"course","code":"LING 180","status":"inactive"},{"type":"course","code":"LING 185B","status":"inactive"}],"count":1,"label":"Linguistics Elective","notes":"Select one course from:"}],"label":"Computing Specialization","notes":"Students may select a specialization in Computing by (1) satisfying all the requirements for a bachelor’s degree in the specified major and (2) completing Program in Computing 10A and 10B and 10C (or Computer Science 31 and 32), Linguistics 185A, Mathematics 61, and one course selected from Linguistics 104, 127, 132, 165A, 165B, 165C, 180, 185B. Students graduate with a bachelor’s degree in their major and a specialization in Computing."}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"COM SCI 31","title":"Introduction to Computer Science I","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Computing Specialization: Computer Science"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Introduction to computer science via theory, applications, and programming. Basic data types, operators and control structures. Input/output. Procedural and data abstraction. Introduction to object-oriented software development. Functions, recursion. Arrays, strings, pointers. Abstract data types, object-oriented programming. Examples and exercises from computer science theory and applications. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI31"},{"id":"COM SCI 32","title":"Introduction to Computer Science II","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Computing Specialization: Computer Science"],"column":1,"prereq_text":"course 31","requires":{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Object-oriented software development. Abstract data type definition and use. Overloading, inheritance, polymorphism. Object-oriented view of data structures: stacks, queues, lists. Algorithm analysis. Trees, graphs, and associated algorithms. Searching and sorting. Case studies and exercises from computer science applications. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI32"},{"id":"COMPTNG 10A","title":"Introduction to Programming","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major: Recommended","Computing Specialization: Program in Computing"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, two hours; laboratory, eight hours. No prior programming experience assumed. Basic principles of programming, using C&plus;&plus;; algorithmic, procedural problem solving; program design and development; basic data types, control structures and functions; functional arrays and pointers; introduction to classes for programmer-defined data types. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG10A"},{"id":"COMPTNG 10B","title":"Intermediate Programming","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Computing Specialization: Program in Computing"],"column":1,"prereq_text":"course 10A or Computer Science 31","requires":{"type":"or","items":[{"type":"course","code":"COMPTNG 10A","concurrent":false,"min_grade":null},{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour; laboratory, eight hours. Object oriented programming in C++; operator overloading; memory management, copy and move constructors, copy and move assignment operators, destructors; iterators; data structures and their implementation, linked lists, binary search trees; inheritance and polymorphism; recursion, algorithms for sorting and searching. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG10B"},{"id":"COMPTNG 10C","title":"Advanced Programming","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Computing Specialization: Program in Computing"],"column":2,"prereq_text":"course 10B","requires":{"type":"course","code":"COMPTNG 10B","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours; laboratory, eight hours. More advanced algorithms and data structuring techniques; additional emphasis on algorithmic efficiency; advanced features of C&plus;&plus;, such as inheritance and virtual functions; graph algorithms. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG10C"},{"id":"LING 20","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LING 102","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"choice","groups":["The Major: Linguistics 102 or 103"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LING 103","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"choice","groups":["The Major: Linguistics 102 or 103"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LING 115","title":"","units":"","offered":[],"level":"","status