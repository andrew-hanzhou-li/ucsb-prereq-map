"}},{"name":"Honors Program","requirement":{"type":"all","items":[{"type":"course","code":"ASIAN 198A","status":"active"},{"type":"course","code":"ASIAN 198B","status":"active"},{"type":"course","code":"ASIAN 198C","status":"active"}],"label":"Honors Program","notes":"The honors program is a three-term sequence (Asian 198A-198B-198C), taken in addition to requirements for the major, that culminates in the submission of a 40- to 60-page thesis. In most circumstances courses 198A-198B-198C are taken in the senior year (fall, winter, and spring quarters), although students also have the option of taking course 198A in spring quarter of their junior year. Students are expected to use an Asian language in their research, with the scope of language work to be determined in consultation with their faculty adviser."}},{"name":"Preparation for the Major","requirement":{"type":"all","items":[{"type":"choose","items":[{"type":"course","code":"KOREA 6","status":"inactive"},{"type":"course","code":"KOREA 6A","status":"inactive"},{"type":"course","code":"KOREA 10","status":"inactive"}],"count":1,"label":"Intermediate Korean Language Courses","notes":"Select one course from the following, or complete an equivalent course:"},{"type":"choose","items":[{"type":"course","code":"ASIAN 30","status":"active"},{"type":"course","code":"KOREA 40","status":"inactive"},{"type":"course","code":"KOREA 50","status":"inactive"},{"type":"course","code":"KOREA M60","status":"inactive"},{"type":"course","code":"KOREA 70","status":"inactive"},{"type":"course","code":"KOREA 80","status":"inactive"}],"count":1,"label":"Elective","notes":"Select one course from:"}],"label":"Preparation for the Major","notes":"Two courses as follows:"}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"ASIAN 30","title":"Languages and Cultures of Asia","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Elective"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Comparative perspective on Asian languages, with emphasis on three major East Asian languages—Chinese, Japanese, and Korean—to show what they share and how they differ in terms of linguistic features, historical development, and larger cultural settings in which these three languages are used. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASIAN30"},{"id":"ASIAN 198A","title":"Honors Research in Asian Languages and Cultures","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Honors Program"],"column":1,"prereq_text":"","requires":null,"ambiguous":false,"description":"Tutorial, three hours. Preparation: one undergraduate departmental seminar. Limited to junior/senior departmental majors. Development of honors thesis under direct supervision of faculty member. May be repeated for credit. Individual contract required. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASIAN198A"},{"id":"ASIAN 198B","title":"Honors Research in Asian Languages and Cultures","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Honors Program"],"column":2,"prereq_text":"course 198A","requires":{"type":"course","code":"ASIAN 198A","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Tutorial, three hours. Limited to junior/senior departmental majors. Continuation of work initiated in course 198A. Presentation of research and relevant progress to supervising faculty member. May be repeated for credit. Individual contract required. In Progress grading (credit to be given only on completion of course 198C).","url":"https://catalog.registrar.ucla.edu/course/2026/ASIAN198B"},{"id":"ASIAN 198C","title":"Honors Research in Asian Languages and Cultures","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role