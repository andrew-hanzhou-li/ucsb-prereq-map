{"major":{"id":"UCLA-MATHEMATICSBS","name":"Mathematics BS","kind":"major","catalog_year":"2026-27","source":"https://catalog.registrar.ucla.edu/major/2026/MATHEMATICSBS","sections":[{"name":"The Major","requirement":{"type":"all","items":[{"type":"course","code":"MATH 110A","status":"inactive"},{"type":"course","code":"MATH 110B","status":"inactive"},{"type":"course","code":"MATH 115A","status":"inactive"},{"type":"course","code":"MATH 120A","status":"inactive"},{"type":"course","code":"MATH 131A","status":"inactive"},{"type":"course","code":"MATH 131B","status":"inactive"},{"type":"course","code":"MATH 132","status":"inactive"},{"type":"choose","items":[{"type":"text","text":"Select from Mathematics 106 through 199."},{"type":"all","items":[{"type":"course","code":"STATS 100A","status":"inactive"},{"type":"course","code":"STATS 100B","status":"inactive"},{"type":"course","code":"STATS 100C","status":"inactive"},{"type":"course","code":"STATS 101A","status":"inactive"},{"type":"course","code":"STATS 101B","status":"inactive"},{"type":"course","code":"STATS 101C","status":"inactive"},{"type":"course","code":"STATS 102A","status":"inactive"},{"type":"course","code":"STATS 102B","status":"inactive"},{"type":"course","code":"STATS 102C","status":"inactive"}],"label":"Statistics"}],"count":5,"label":"Electives","notes":"Select at least five elective courses from the following:"}],"label":"The Major","notes":"Twelve courses as follows:"}},{"name":"Computing Specialization","requirement":{"type":"all","items":[{"type":"choose","items":[{"type":"course","code":"MATH 61","status":"inactive"},{"type":"course","code":"MATH 180","status":"inactive"}],"count":1,"label":"Mathematics 61 or 180","notes":"Select one course from:"},{"type":"all","items":[{"type":"course","code":"COMPTNG 10A","status":"active"},{"type":"course","code":"COMPTNG 10B","status":"active"}],"label":"Program in Computing"},{"type":"choose","items":[{"type":"course","code":"COMPTNG 10C","status":"active"},{"type":"course","code":"COMPTNG 15","status":"active"},{"type":"course","code":"COMPTNG 16A","status":"active"},{"type":"course","code":"COMPTNG 20A","status":"active"},{"type":"course","code":"COMPTNG 40A","status":"active"}],"count":2,"label":"Program in Computing Electives","notes":"Select two courses from:"},{"type":"choose","items":[{"type":"text","text":"Mathematics 149 through 159"}],"count":2,"label":"Mathematics Electives","notes":"Select two courses from:"}],"label":"Computing Specialization","notes":"Majors may select a specialization in Computing by (1) satisfying all the requirements for a bachelor’s degree in the specified major and (2) completing Mathematics 61 or 180, Program in Computing 10A, 10B, two courses from 10C, 15, 16A, 20A, 40A, and at least two courses from Mathematics 149 through 159, with a minimum grade of C– in each course and a combined grade-point average of at least 2.0. Students must petition for admission to this program and are advised to do so after they complete Program in Computing 10B (petitions should be filed in the Student Services Office). Students graduate with a bachelor’s degree in their major and a specialization in Computing."}},{"name":"Preparation for the Major","requirement":{"type":"all","items":[{"type":"course","code":"MATH 31A","status":"inactive"},{"type":"course","code":"MATH 31AL","status":"inactive"},{"type":"course","code":"MATH 31B","status":"inactive"},{"type":"course","code":"MATH 32A","status":"inactive"},{"type":"course","code":"MATH 32B","status":"inactive"},{"type":"course","code":"MATH 33A","status":"inactive"},{"type":"course","code":"MATH 33B","status":"inactive"},{"type":"course","code":"COMPTNG 10A","status":"active"},{"type":"course","code":"PHYSICS 1A","status":"inactive"},{"type":"choose","items":[{"type":"course","code":"CHEM 20A","status":"active"},{"type":"course","code":"CHEM 20B","status":"active"},{"type":"course","code":"ECON 11","status":"inactive"},{"type":"course","code":"LIFESCI 7A","status":"inactive"},{"type":"course","code":"PHILOS 31","status":"inactive"},{"type":"course","code":"PHILOS 132","status":"inactive"},{"type":"course","code":"PHYSICS 1B","status":"inactive"},{"type":"course","code":"PHYSICS 1C","status":"inactive"},{"type":"course","code":"PHYSICS 5B","status":"inactive"},{"type":"course","code":"PHYSICS 5C","status":"inactive"}],"count":2,"label":"Electives","notes":"Select two courses from:"}],"label":"Preparation for the Major"}},{"name":"Honors Program","requirement":{"type":"text","text":"The program entails taking a specified sequence of courses as part of the major requirements, completing an approved seminar offered by the Mathematics Department or submitting an original research project, and earning an overall GPA of at least 3.6 in approved upper-division and graduate mathematics courses."}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"CHEM 14A","title":"General Chemistry for Life Scientists I","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Life Sciences 30A or Mathematics 3A or 31A or score of 48 or better on Mathematics Diagnostic Test) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 3A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},{"type":"condition","kind":"other","text":"score of 48"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 20A. Introduction to physical and general chemistry principles; atomic structure based on quantum mechanics; atomic properties; trends in periodic table; chemical bonding (Lewis structures, VSEPR theory, hybridization, and molecular orbital theory); coordination compounds; properties of inorganic and organic acids, bases, buffers. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14A"},{"id":"CHEM 14AE","title":"General Chemistry for Life Scientists I—Enhanced","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Life Sciences 30A or Mathematics 3A or 31A or score of 48 or better on Mathematics Diagnostic Test) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 3A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},{"type":"condition","kind":"other","text":"score of 48"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 14A or 20A. Study of foundations of chemistry. Discussion of foundations of quantum mechanics and how these principles can be used to understand atomic and molecular structure and properties; how molecules interact; and properties of inorganic, organic, and biological acids, bases, and salts. Biological, environmental, and socially-relevant examples are used to illustrate central role that chemistry plays in our world. Emphasis on developing problem-solving skills and collaborative interaction and learning. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14AE"},{"id":"CHEM 20A","title":"Chemical Structure","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Electives"],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Mathematics 31A) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 14A. First term of general chemistry. Survey of chemical processes, quantum chemistry, atomic and molecular structure and bonding, molecular spectroscopy. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20A"},{"id":"CHEM 20AH","title":"Chemical Structure (Honors)","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"(Mathematics 31A) (may be taken concurrently)","requires":{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background, high school physics, and three and one half years of high school mathematics. Honors course parallel to course 20A. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20AH"},{"id":"CHEM 20B","title":"Chemical Energetics and Change","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Electives"],"column":1,"prereq_text":"course 14A or 14AE or 20A or 20AH, and Mathematics 31A, with grades of C– or better; and (Mathematics 31B) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"CHEM 14A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 14AE","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20AH","concurrent":false,"min_grade":"C-"}]},{"type":"course","code":"MATH 31A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"MATH 31B","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Second term of general chemistry. Intermolecular forces and organization, phase behavior, chemical thermodynamics, solutions, equilibria, reaction rates and laws. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20B"},{"id":"COM SCI 31","title":"Introduction to Computer Science I","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Introduction to computer science via theory, applications, and programming. Basic data types, operators and control structures. Input/output. Procedural and data abstraction. Introduction to object-oriented software development. Functions, recursion. Arrays, strings, pointers. Abstract data types, object-oriented programming. Examples and exercises from computer science theory and applications. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI31"},{"id":"COM SCI 32","title":"Introduction to Computer Science II","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":1,"prereq_text":"course 31","requires":{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Object-oriented software development. Abstract data type definition and use. Overloading, inheritance, polymorphism. Object-oriented view of data structures: stacks, queues, lists. Algorithm analysis. Trees, graphs, and associated algorithms. Searching and sorting. Case studies and exercises from computer science applications. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI32"},{"id":"COMPTNG 10A","title":"Introduction to Programming","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Computing Specialization: Program in Computing","Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, two hours; laboratory, eight hours. No prior programming experience assumed. Basic principles of programming, using C&plus;&plus;; algorithmic, procedural problem solving; program design and development; basic data types, control structures and functions; functional arrays and pointers; introduction to classes for programmer-defined data types. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG10A"},{"id":"COMPTNG 10B","title":"Intermediate Programming","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Computing Specialization: Program in Computing"],"column":1,"prereq_text":"course 10A or Computer Science 31","requires":{"type":"or","items":[{"type":"course","code":"COMPTNG 10A","concurrent":false,"min_grade":null},{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour; laboratory, eight hours. Object oriented programming in C++; operator overloading; memory management, copy and move constructors, copy and move assignment operators, destructors; iterators; data structures and their implementation, linked lists, binary search trees; inheritance and polymorphism; recursion, algorithms for sorting and searching. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG10B"},{"id":"COMPTNG 10C","title":"Advanced Programming","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Computing Specialization: Program in Computing Electives"],"column":2,"prereq_text":"course 10B","requires":{"type":"course","code":"COMPTNG 10B","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours; laboratory, eight hours. More advanced algorithms and data structuring techniques; additional emphasis on algorithmic efficiency; advanced features of C&plus;&plus;, such as inheritance and virtual functions; graph algorithms. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG10C"},{"id":"COMPTNG 15","title":"Introduction to Lisp and Symbolic Computation","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Computing Specialization: Program in Computing Electives"],"column":1,"prereq_text":"course 10A","requires":{"type":"course","code":"COMPTNG 10A","concurrent":false,"min_grade":null},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours; laboratory, eight hours. Introduction to symbolic computation using Lisp programming language. Basics: list structures, recursion, function abstraction. Advanced topics: knowledge representation, higher-order functions, problem-solving algorithms and heuristics. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG15"},{"id":"COMPTNG 16A","title":"Python with Applications I","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Computing Specialization: Program in Computing Electives"],"column":1,"prereq_text":"course 10A, Computer Science 31, or equivalent, with grades of C– or better","requires":{"type":"or","items":[{"type":"course","code":"COMPTNG 10A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":"C-"},{"type":"condition","kind":"other","text":"equivalent"}]},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours. In-depth introduction to Python programming language for students who have already taken beginning programming course in strongly typed, compiled language (C++, C, or Fortran). Core Python language constructs, applications, text processing, data visualization, interaction with spreadsheets and SQL databases, and creation of graphical user interfaces. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG16A"},{"id":"COMPTNG 20A","title":"Principles of Java Language with Applications","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Computing Specialization: Program in Computing Electives"],"column":1,"prereq_text":"course 10A or Computer Science 31","requires":{"type":"or","items":[{"type":"course","code":"COMPTNG 10A","concurrent":false,"min_grade":null},{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours; laboratory, eight hours. Not open for credit to students with credit for course 3. Introduction to Java computer language. Class and interface hierarchies; graphics components and graphical user interfaces; streams; multithreading; event and exception handling. Issues in class design and design of interactive web pages. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG20A"},{"id":"COMPTNG 40A","title":"Introduction to Programming for Internet","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Computing Specialization: Program in Computing Electives"],"column":2,"prereq_text":"course 10A or Computer Science 31 or equivalent, and one from course 10B, 16A, 20A, Computer Science 32, or equivalent, with grades of C– or better","requires":{"type":"or","items":[{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"COMPTNG 10A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":"C-"},{"type":"condition","kind":"other","text":"equivalent"}]},{"type":"course","code":"COMPTNG 10B","concurrent":false,"min_grade":"C-"}]},{"type":"course","code":"COMPTNG 16A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"COMPTNG 20A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"COM SCI 32","concurrent":false,"min_grade":"C-"},{"type":"condition","kind":"other","text":"equivalent"}]},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours. Introduction to programming for World Wide Web for students with strong foundation in programming. HTML5 and CSS3 markup languages to design websites; client-side scripting with JavaScript to enable event-driven interactivity, animations, and cookie tracking; server-side scripting with PHP to render HTML pages, store, and retrieve data on server; and introduction to databases through SQLite3. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG40A"},{"id":"ECON 11","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major: Electives"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LIFESCI 7A","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major: Electives"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LIFESCI 30A","title":"","units":"","offered":[],"level":"","status":"not