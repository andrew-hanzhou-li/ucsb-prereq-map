{"major":{"id":"UCLA-NURSINGBSPRELICENSURE","name":"Nursing BS Prelicensure","kind":"major","catalog_year":"2026-27","source":"https://catalog.registrar.ucla.edu/major/2026/NURSINGBSPRELICENSURE","sections":[{"name":"The Major","requirement":{"type":"all","items":[{"type":"course","code":"NURSING 115","status":"inactive"},{"type":"course","code":"NURSING 150A","status":"inactive"},{"type":"course","code":"NURSING 150B","status":"inactive"},{"type":"course","code":"NURSING 152A","status":"inactive"},{"type":"course","code":"NURSING 152B","status":"inactive"},{"type":"course","code":"NURSING 160","status":"inactive"},{"type":"course","code":"NURSING 161","status":"inactive"},{"type":"course","code":"NURSING 162A","status":"inactive"},{"type":"course","code":"NURSING 162B","status":"inactive"},{"type":"course","code":"NURSING 162C","status":"inactive"},{"type":"course","code":"NURSING 163","status":"inactive"},{"type":"course","code":"NURSING 164","status":"inactive"},{"type":"course","code":"NURSING 165","status":"inactive"},{"type":"course","code":"NURSING 168","status":"inactive"},{"type":"course","code":"NURSING 171","status":"inactive"},{"type":"course","code":"NURSING 174","status":"inactive"},{"type":"all","items":[{"type":"course","code":"NURSING 169","status":"inactive"}],"label":"Capstone Senior Scholarly Project"}],"label":"The Major"}},{"name":"Preparation for the Major","requirement":{"type":"all","items":[{"type":"course","code":"BIOSTAT 100","status":"active"},{"type":"course","code":"CHEM 14A","status":"active"},{"type":"course","code":"CHEM 14B","status":"active"},{"type":"course","code":"CHEM 14C","status":"active"},{"type":"course","code":"LIFESCI 7A","status":"inactive"},{"type":"course","code":"LIFESCI 7C","status":"inactive"},{"type":"course","code":"NURSING 3","status":"inactive"},{"type":"course","code":"NURSING 10","status":"inactive"},{"type":"course","code":"NURSING 13","status":"inactive"},{"type":"course","code":"NURSING 20","status":"inactive"},{"type":"course","code":"NURSING 50","status":"inactive"},{"type":"course","code":"NURSING 51","status":"inactive"},{"type":"course","code":"NURSING 54A","status":"inactive"},{"type":"course","code":"NURSING 54B","status":"inactive"},{"type":"course","code":"NURSING 173W","status":"inactive"},{"type":"course","code":"PSYCH 10","status":"inactive"},{"type":"choose","items":[{"type":"course","code":"COMM 1","status":"active"},{"type":"course","code":"COMM 10","status":"active"}],"count":1,"label":"Communication","notes":"Select one course from:"},{"type":"choose","items":[{"type":"course","code":"MATH 3A","status":"inactive"},{"type":"course","code":"MATH 31A","status":"inactive"}],"count":1,"label":"Mathematics","notes":"Select one course from:"}],"label":"Preparation for the Major"}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"BIOSTAT 100","title":"Introduction to Biostatistics","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"(Formerly numbered 100A.) Lecture, three hours; discussion, one hour; laboratory, one hour. Preparation: one biological or physical sciences course. Suitable for juniors/seniors. Limited to nonmajors. Not open for credit to students with credit for course 120. Students who have completed courses in statistics may enroll only with consent of instructor. Introduction to methods and concepts of statistical analysis. Sampling situations, with special attention to those occurring in biological sciences. Topics include distributions, tests of hypotheses, estimation, types of error, significance and confidence levels, sample size. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/BIOSTAT100"},{"id":"CHEM 14A","title":"General Chemistry for Life Scientists I","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Life Sciences 30A or Mathematics 3A or 31A or score of 48 or better on Mathematics Diagnostic Test) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 3A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},{"type":"condition","kind":"other","text":"score of 48"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 20A. Introduction to physical and general chemistry principles; atomic structure based on quantum mechanics; atomic properties; trends in periodic table; chemical bonding (Lewis structures, VSEPR theory, hybridization, and molecular orbital theory); coordination compounds; properties of inorganic and organic acids, bases, buffers. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14A"},{"id":"CHEM 14B","title":"General Chemistry for Life Scientists II","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"one course from 14A, 14AE, 20A, or 20AH with grade of C– or better; and (Life Sciences 30B or Mathematics 3B or 31B with grade of C– or better) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"one course from 14A"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30B","concurrent":true,"min_grade":"C-"},{"type":"course","code":"MATH 3B","concurrent":true,"min_grade":"C-"},{"type":"course","code":"MATH 31B","concurrent":true,"min_grade":"C-"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Enforced requisite or Not open to students with credit for course 14BE, 20B, or 20BH. Chemical equilibria in gases and liquids, acid-base equilibrium; phase changes; thermochemistry; first, second, and third laws of thermodynamics; free energy changes; electrochemistry and its role as energy source; chemical kinetics, including catalysis, and reaction mechanisms. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14B"},{"id":"CHEM 14C","title":"Structure of Organic Molecules","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"course 14B with grade of C– or better","requires":{"type":"course","code":"CHEM 14B","concurrent":false,"min_grade":"C-"},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Not open to students with credit for course 30A. Continuing studies in structure of organic molecules, with emphasis on biological applications. Resonance, stereochemistry, conjugation, and aromaticity; spectroscopy (NMR, IR, and mass spectrometry); introduction to effects of structure on physical and chemical properties; survey of biomolecular structure. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14C"},{"id":"COMM 1","title":"Principles of Oral Communication","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major: Communication"],"column":0,"prereq_text":"satisfaction of Entry-Level Writing requirement","requires":{"type":"condition","kind":"other","text":"satisfaction of Entry-Level Writing requirement"},"ambiguous":false,"description":"Lecture, four hours. Examination of foundations of communication and public speaking. Consideration of number of basic theories related to study of communication and development of skills to enable composition and delivery of speeches in accordance with specific rhetorical concepts. Improvement of ability to analyze, organize, and critically think about communicative messages while becoming better equipped to articulate ideas. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMM1"},{"id":"COMM 10","title":"Introduction to Communication","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major: Communication"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, four hours; discussion, one hour. Introduction to study of interpersonal and mass communication using interdisciplinary approach. Exploration of basic methods and theoretical perspectives that social scientists and others use to study interpersonal and mass communication, and basic concepts used to describe and explain that communication. Historical overview of each major mass media. Study of significant current topical issues related to means of communication that reach large numbers of people. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMM10"},{"id":"LIFESCI 7A","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LIFESCI 7C","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LIFESCI 30A","title":"","units":"","offered":[],"level":"","status":"not_in_catalog","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LIFESCI 30B","title":"","units":"","offe