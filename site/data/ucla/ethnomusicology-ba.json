{"type":"course","code":"ETHNMUS 177","status":"inactive"},{"type":"course","code":"ETHNMUS C178","status":"inactive"},{"type":"course","code":"ETHNMUS CM182","status":"inactive"},{"type":"course","code":"ETHNMUS C184","status":"inactive"},{"type":"course","code":"ETHNMUS 188","status":"inactive"},{"type":"course","code":"ETHNMUS 199","status":"inactive"}],"count":7,"label":"Electives","notes":"Select a minimum of seven, 4- or 5-unit upper-division ethnomusicology courses from the following:"},{"type":"all","items":[{"type":"all","items":[{"type":"course","code":"ETHNMUS 186","status":"inactive"}],"label":"Performance/Composition Capstone","notes":"Students must complete two quarters of Ethnomusicology 186. Additionally, students in performance or composition must submit 5 to 10 pages of writing describing their work. Performance students must offer a public performance that is 25 to 45 minutes long. This may be a solo performance, a significant role in a chamber group, or a significant (lead) role in a departmental ensemble concert. The program must be approved in advance by the faculty mentor. In the case of a departmental ensemble performance, the student must obtain the written permission of the ensemble director indicating support for the project. Composition students must submit a composition or compositions to their faculty mentor. The composition(s) should be 20 to 25 minutes in length and be performed. Playing digital music (MIDI) recordings of compositions is acceptable, but at least one composition must be performed by musicians live. The performance of the composition must take place during the spring quarter."},{"type":"all","items":[{"type":"course","code":"ETHNMUS 195B","status":"inactive"},{"type":"course","code":"ETHNMUS 199","status":"inactive"}],"label":"Public Ethnomusicology Capstone","notes":"Students must complete an internship of one quarter in length, of at least 10 hours per week, during which they enroll in Ethnomusicology 195B. Students must then complete Ethnomusicology 199, in which they produce a paper of 12 to 15 pages in length detailing their experience."},{"type":"all","items":[{"type":"course","code":"ETHNMUS 199","status":"inactive"}],"label":"Scholarly Research Capstone","notes":"Students must complete two quarters of Ethnomusicology 199, in which they produce a research paper of high quality, 30 to 40 pages in length, based on fieldwork, archival work, or primary texts. Final approval of the completed paper is given by the faculty mentor."},{"type":"all","items":[{"type":"course","code":"ETHNMUS 199","status":"inactive"}],"label":"Independent Capstone","notes":"In consultation with a faculty adviser, students may propose capstone projects in other emphasis concepts such as technologies, film scoring, interactive arts, dance, etc. Students must complete two quarters of Ethnomusicology 199 (2 units minimum). Students pursuing an independent capstone must submit 5 to 10 pages of writing describing their work."}],"label":"Capstone","notes":"The capstone project provides seniors with an opportunity to demonstrate the knowledge and abilities acquired during their undergraduate studies. Students must complete one of the following four capstone options. Students must submit a capstone proposal with supporting materials to their faculty mentor and then to the school Office of Student Affairs for approval. For details on the submission process, contact the Office of Student Affairs."}],"label":"The Major"}},{"name":"Preparation for the Major","requirement":{"type":"all","items":[{"type":"all","items":[{"type":"course","code":"ETHNMUS M6A","status":"inactive"}],"label":"Musicianship"},{"type":"all","items":[{"type":"course","code":"ETHNMUS 10A","status":"inactive"},{"type":"course","code":"ETHNMUS 10B","status":"inactive"}],"label":"Music Theory and Musicianship"},{"type":"all","items":[{"type":"course","code":"ETHNMUS 20A","status":"inactive"},{"type":"course","code":"ETHNMUS 20B","status":"inactive"},{"type":"course","code":"ETHNMUS 20C","status":"inactive"}],"label":"Musical Cultures of the World"},{"type":"all","items":[{"type":"course","code":"ETHNMUS 83","status":"inactive"}],"label":"Basic Principles of Ethnomusicology"},{"type":"units","items":[{"type":"all","items":[{"type":"text","text":"Ethnomusicology 91A through 91Z"}],"label":"World Music Performance Organizations"},{"type":"all","items":[{"type":"course","code":"ETHNMUS 92","status":"inactive"}],"label":"Private Instruction in Music"},{"type":"all","items":[{"type":"text","text":"Ethnomusicology 68A through 68Z"}],"label":"World Music Specializations"}],"units":12,"label":"Ensembles: World Music Performance Organizations, Private Instruction in Music, and World Music Specializations","notes":"Select 12 units from the following:"}],"label":"Preparation for the Major"}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"ETHNMUS 10A","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major: Music Theory and Musicianship"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"ETHNMUS 10B","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major: Music Theory and Musicianship"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"ETHNMUS 20A","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major: Musical Cultures of the World"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"ETHNMUS 20B","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major: Musical Cultures of the World"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"ETHNMUS 20C",