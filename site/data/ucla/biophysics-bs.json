{"major":{"id":"UCLA-BIOPHYSICSBS","name":"Biophysics BS","kind":"major","catalog_year":"2026-27","source":"https://catalog.registrar.ucla.edu/major/2026/BIOPHYSICSBS","sections":[{"name":"Preparation for the Major","requirement":{"type":"all","items":[{"type":"all","items":[{"type":"course","code":"PHYSICS 1A","status":"inactive"},{"type":"course","code":"PHYSICS 1B","status":"inactive"},{"type":"course","code":"PHYSICS 1C","status":"inactive"},{"type":"course","code":"PHYSICS 4AL","status":"inactive"},{"type":"course","code":"PHYSICS 4BL","status":"inactive"},{"type":"course","code":"PHYSICS 17","status":"inactive"},{"type":"course","code":"PHYSICS 32","status":"inactive"},{"type":"all","items":[{"type":"course","code":"PHYSICS 1AH","status":"inactive"},{"type":"course","code":"PHYSICS 1BH","status":"inactive"},{"type":"course","code":"PHYSICS 1CH","status":"inactive"}],"label":"Physics 1 Honors series","notes":"Students may substitute courses from the Physics 1 honors series for the Physics 1 series."}],"label":"Physics"},{"type":"all","items":[{"type":"course","code":"CHEM 20A","status":"active"},{"type":"course","code":"CHEM 20B","status":"active"}],"label":"Chemistry"},{"type":"all","items":[{"type":"course","code":"LIFESCI 7A","status":"inactive"}],"label":"Life Sciences"},{"type":"all","items":[{"type":"course","code":"MATH 31A","status":"inactive"},{"type":"course","code":"MATH 31AL","status":"inactive"},{"type":"course","code":"MATH 31B","status":"inactive"},{"type":"course","code":"MATH 32A","status":"inactive"},{"type":"course","code":"MATH 32B","status":"inactive"},{"type":"course","code":"MATH 33A","status":"inactive"},{"type":"course","code":"MATH 33B","status":"inactive"}],"label":"Mathematics"},{"type":"all","items":[{"type":"course","code":"PHYSICS 18L","status":"inactive"}],"label":"Recommended","notes":"The following course is recommended:"}],"label":"Preparation for the Major"}},{"name":"The Major","requirement":{"type":"all","items":[{"type":"all","items":[{"type":"course","code":"PHYSICS 105A","status":"inactive"},{"type":"course","code":"PHYSICS 110A","status":"inactive"},{"type":"course","code":"PHYSICS 110B","status":"inactive"},{"type":"course","code":"PHYSICS 112","status":"inactive"},{"type":"course","code":"PHYSICS 115A","status":"inactive"},{"type":"course","code":"PHYSICS 115B","status":"inactive"},{"type":"course","code":"PHYSICS M180G","status":"inactive"},{"type":"course","code":"PHYSICS C187A","status":"inactive"},{"type":"course","code":"PHYSICS C187B","status":"inactive"}],"label":"Required Physics"},{"type":"choose","items":[{"type":"all","items":[{"type":"course","code":"NEUROSC M101A","status":"inactive"},{"type":"course","code":"PHYSICS 170A","status":"inactive"},{"type":"course","code":"PHYSICS C186","status":"inactive"}],"label":"Group A (Physics of Neuroscience)"},{"type":"all","items":[{"type":"course","code":"PHYSICS 144","status":"inactive"},{"type":"course","code":"PHYSICS 170A","status":"inactive"},{"type":"course","code":"MECH&AE C286","status":"inactive"}],"label":"Group B (Biological Physics)"},{"type":"all","items":[{"type":"course","code":"CHEM 153A","status":"active"},{"type":"course","code":"CHEM 153L","status":"active"},{"type":"course","code":"MCD BIO 100","status":"inactive"},{"type":"course","code":"MCD BIO 165A","status":"inactive"}],"label":"Group C (Molecular and Cellular Biophysics)"}],"count":3,"label":"Upper-Division Electives","notes":"Select three additional upper-division elective courses from one group or among the three groups:"}],"label":"The Major"}},{"name":"Honors Program","requirement":{"type":"all","items":[{"type":"course","code":"PHYSICS 199","status":"inactive"}],"label":"Honors Program","notes":"In addition to completing all courses required for the major, students must complete two 4-unit terms of Physics 199."}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"CHEM 14A","title":"General Chemistry for Life Scientists I","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Life Sciences 30A or Mathematics 3A or 31A or score of 48 or better on Mathematics Diagnostic Test) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 3A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},{"type":"condition","kind":"other","text":"score of 48"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 20A. Introduction to physical and general chemistry principles; atomic structure based on quantum mechanics; atomic properties; trends in periodic table; chemical bonding (Lewis structures, VSEPR theory, hybridization, and molecular orbital theory); coordination compounds; properties of inorganic and organic acids, bases, buffers. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14A"},{"id":"CHEM 14AE","title":"General Chemistry for Life Scientists I—Enhanced","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Life Sciences 30A or Mathematics 3A or 31A or score of 48 or better on Mathematics Diagnostic Test) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 3A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},{"type":"condition","kind":"other","text":"score of 48"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 14A or 20A. Study of foundations of chemistry. Discussion of foundations of quantum mechanics and how these principles can be used to understand atomic and molecular structure and properties; how molecules interact; and properties of inorganic, organic, and biological acids, bases, and salts. Biological, environmental, and socially-relevant examples are used to illustrate central role that chemistry plays in our world. Emphasis on developing problem-solving skills and collaborative interaction and learning. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14AE"},{"id":"CHEM 14B","title":"General Chemistry for Life Scientists II","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"one course from 14A, 14AE, 20A, or 20AH with grade of C– or better; and (Life Sciences 30B or Mathematics 3B or 31B with grade of C– or better) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"one course from 14A"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30B","concurrent":true,"min_grade":"C-"},{"type":"course","code":"MATH 3B","concurrent":true,"min_grade":"C-"},{"type":"course","code":"MATH 31B","concurrent":true,"min_grade":"C-"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Enforced requisite or Not open to students with credit for course 14BE, 20B, or 20BH. Chemical equilibria in gases and liquids, acid-base equilibrium; phase changes; thermochemistry; first, second, and third laws of thermodynamics; free energy changes; electrochemistry and its role as energy source; chemical kinetics, including catalysis, and reaction mechanisms. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14B"},{"id":"CHEM 14BL","title":"General and Organic Chemistry Laboratory I","units":"3","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":1,"prereq_text":"course 14A or 20A or 20AH with grade of C– or better; and (course 14B) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"CHEM 14A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20AH","concurrent":false,"min_grade":"C-"}]},{"type":"course","code":"CHEM 14B","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, one hour; laboratory, three hours. Not open to students with credit for course 20L. Introduction to volumetric, spectrophotometric, and potentiometric analysis. Use and preparation of buffers and pH meters. Synthesis and kinetics techniques using compounds of interest to students in life sciences. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14BL"},{"id":"CHEM 14C","title":"Structure of Organic Molecules","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":1,"prereq_text":"course 14B with grade of C– or better","requires":{"type":"course","code":"CHEM 14B","concurrent":false,"min_grade":"C-"},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Not open to students with credit for course 30A. Continuing studies in structure of organic molecules, with emphasis on biological applications. Resonance, stereochemistry, conjugation, and aromaticity; spectroscopy (NMR, IR, and mass spectrometry); introduction to effects of structure on physical and chemical properties; survey of biomolecular structure. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14C"},{"id":"CHEM 14D","title":"Organic Reactions and Pharmaceuticals","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":2,"prereq_text":"course 14C with grade of C– or better","requires":{"type":"course","code":"CHEM 14C","concurrent":false,"min_grade":"C-"},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Organic reactions, nucleophilic and electrophilic substitutions and additions; electrophilic aromatic substitutions, carbonyl reactions, catalysis, molecular basis of drug action, and organic chemistry of pharmaceuticals. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14D"},{"id":"CHEM 20A","title":"Chemical Structure","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major: Chemistry"],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Mathematics 31A) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 14A. First term of general chemistry. Survey of chemical processes, quantum chemistry, atomic and molecular structure and bonding, molecular spectroscopy. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20A"},{"id":"CHEM 20AH","title":"Chemical Structure (Honors)","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"(Mathematics 31A) (may be taken concurrently)","requires":{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background, high school physics, and three and one half years of high school mathematics. Honors course parallel to course 20A. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20AH"},{"id":"CHEM 20B","title":"Chemical Energetics and Change","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major: Chemistry"],"column":1,"prereq_text":"course 14A or 14AE or 20A or 20AH, and Mathematics 31A, with grades of C– or better; and (Mathematics 31B) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"CHEM 14A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 14AE","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20AH","concurrent":false,"min_grade":"C-"}]},{"type":"course","code":"MATH 31A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"MATH 31B","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Second term of general chemistry. Intermolecular forces and organization, phase behavior, chemical thermodynamics, solutions, equilibria, reaction rates and laws. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20B"},{"id":"CHEM 20BH","title":"Chemical Energetics and Change (Honors)","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":1,"prereq_text":"course 20A and Mathematics 31A with grades of B&plus; or better or 20AH with grade of B or better; and (Mathematics 31B) (may be taken concurrently)","requires":{"type":"or","items":[{"type":"and","items":[{"type":"course","code":"CHEM 20A","concurrent":false,"min_grade":"B"},{"type":"course","code":"MATH 31A","concurrent":false,"min_grade":"B"},{"type":"condition","kind":"other","text":"plus"}]},{"type":"and","items":[{"type":"or","items":[{"type":"condition","kind":"other","text":"better"},{"type":"course","code":"MATH 20AH","concurrent":false,"min_grade":"B"}]},{"type":"course","code":"MATH 31B","concurrent":true,"min_grade":null}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Honors course parallel to course 20B. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20BH"},{"id":"CHEM 20L","title":"General Chemistry Laboratory","units":"3","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":1,"prereq_text":"course 14A or 20A with grade of C– or better; and (course 14B or 20B) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"CHEM 14A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20A","concurrent":false,"min_grade":"C-"}]},{"type":"or","items":[{"type":"course","code":"CHEM 14B","concurrent":true,"min_grade":null},{"type":"course","code":"CHEM 20B","concurrent":true,"min_grade":null}]}]},"ambiguous":false,"description":"Lecture, one hour; laboratory, three hours. Use of balance, volumetric techniques, volumetric and potentiometric analysis; Beer’s law, applications for environmental analysis and materials science. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20L"},{"id":"CHEM 30A","title":"Organic Chemistry I: Structure and Reactivity","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":2,"prereq_text":"course 20B with grade of C– or better","requires":{"type":"course","code":"CHEM 20B","concurrent":false,"min_grade":"C-"},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. First term of organic chemistry for Chemistry, Biochemistry, and engineering majors. Covalent bonding, shapes, stereochemistry, and acid/base properties of organic molecules. Properties, synthesis, and reactions of alkanes, cycloalkanes, alkenes, and alkynes. SN2, SN1, elimination, and radical reactions. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM30A"},{"id":"CHEM 30AH","title":"","units":"","offered":[],"level":"","status":"not_in_catalog","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"CHEM 30AL","title":"General Chemistry Laboratory II","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":2,"prereq_text":"courses 20B (or 20BH), 20L, and 30A (or 30AH), with grades of C– or better","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"CHEM 20B","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20BH","concurrent":false,"min_grade":"C-"}]},{"type":"course","code":"CHEM 20L","concurrent":false,"min_grade":"C-"},{"type":"or","items":[{"type":"course","code":"CHEM 30A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 30AH","concurrent":false,"min_grade":"C-"}]}]},"ambiguous":false,"description":"Lecture, one hour; laboratory, six hours. Qualitative and quantitative analysis of chemical reactions and compounds, kinetics, separations, and spectroscopy. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM30AL"},{"id":"CHEM 30B","title":"Organic Chemistry II: Reactivity, Synthesis, and Spectroscopy","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":1,"prereq_text":"course 30A or 30AH, with grade of C– or better","requires":{"type":"or","items":[{"type":"course","code":"CHEM 30A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 30AH","concurrent":false,"min_grade":"C-"}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Second term of organic chemistry for Chemistry, Biochemistry, and engineering majors. Properties, synthesis, and reactions of alcohols, ethers, sulfur compounds, aldehydes, ketones, carboxylic acids, and carboxylic acid derivatives. Organometallic compounds. Organic spectroscopy, including mass spectrometry, infrared spectroscopy, and proton and carbon nuclear magnetic resonance spectroscopy. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM30B"},{"id":"CHEM 153A","title":"Biochemistry: Introduction to Structure, Enzymes, and Metabolism","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Group C (Molecular and Cellular Biophysics)"],"column":2,"prereq_text":"course 14D or 30B, with grade of C– or better","requires":{"type":"or","items":[{"type":"course","code":"CHEM 14D","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 30B","concurrent":false,"min_grade":"C-"}]},"ambiguous":false,"description":"Lecture, four hours; discussion, one hour. Recommended: Life Sciences 2, 3, and 23L, or 7A. Structure of proteins, carbohydrates, and lipids; enzyme catalysis and principles of metabolism, including glycolysis, citric acid cycle, and oxidative phosphorylation. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM153A"},{"id":"CHEM 153AH","title":"Biochemistry: Introduction to Structure, Enzymes, and Metabolism (Honors)","units":"4","offered":[],"level":"upper","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":2,"prereq_text":"course 14D or 30B, with grade of C– or better","requires":{"type":"or","items":[{"type":"course","code":"CHEM 14D","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 30B","concurrent":false,"min_grade":"C-"}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour; tutorial, one hour. Recommended: Life Sciences 2, 3, 23L. Honors course parallel to course 153A. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM153AH"},{"id":"CHEM 153L","title":"Biochemical Methods I","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Group C (Molecular and Cellular Biophysics)"],"column":3,"prereq_text":"courses 14BL or 20L and 30AL, and 153A or 153AH (may be taken concurrently), with grades of C– or better","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"CHEM 14BL","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20L","concurrent":false,"min_grade":"C-"}]},{"type":"course","code":"CHEM 30AL","concurrent":false,"min_grade":"C-"},{"type":"or","items":[{"type":"course","code":"CHEM 153A","concurrent":true,"min_grade":"C-"},{"type":"course","code":"CHEM 153AH","concurrent":true,"min_grade":"C-"}]}]},"ambiguous":true,"description":"Lecture, two hours; laboratory, four hours. Integrated term-long project involving biofuel production in bacteria. Purification of key enzyme for alcohol production from bacteria via affinity chromatography. Assessment of protein amount, purity, and activity of enzyme. Techniques include protein determination by Bradford assay, polyacrylamide gel electrophoresis, immunoblotting, and enzyme activity assays to determine enzyme activity (Km, Vmax, inhibitor studies). P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM153L"},{"id":"LIFESCI 7A","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major: Life Sciences"],"column":0,"prereq_text":"