tatus":"inactive"},{"type":"course","code":"C&EE ST CM126","status":"active"},{"type":"course","code":"CZCH 155","status":"active"},{"type":"course","code":"HIST 120A","status":"inactive"},{"type":"course","code":"HIST 120B","status":"inactive"},{"type":"course","code":"HIST 120C","status":"inactive"},{"type":"course","code":"HIST 120D","status":"inactive"},{"type":"course","code":"POLSH 152A","status":"inactive"},{"type":"course","code":"POLSH 152B","status":"inactive"},{"type":"course","code":"POLSH 152C","status":"inactive"},{"type":"course","code":"ROMANIA 152","status":"inactive"},{"type":"course","code":"RUSSN CM124G","status":"inactive"},{"type":"course","code":"UKRN 152","status":"inactive"}],"label":"Courses"},{"type":"all","items":[{"type":"text","text":"Czech, Hungarian, Polish, Romanian, Serbian/Croatian, Ukrainian 187A through 187M"}],"label":"Czech, Hungarian, Polish, Romanian, Serbian/Croatian, Ukrainian 187A through 187M"},{"type":"all","items":[{"type":"course","code":"RUSSN M118","status":"inactive"},{"type":"course","code":"RUSSN 119","status":"inactive"},{"type":"course","code":"RUSSN 120","status":"inactive"},{"type":"course","code":"RUSSN C124C","status":"inactive"},{"type":"course","code":"RUSSN C124D","status":"inactive"},{"type":"course","code":"RUSSN C124N","status":"inactive"},{"type":"course","code":"RUSSN C124T","status":"inactive"}],"label":"Additional Russian Electives","notes":"One of the three courses may be selected from:"}],"count":3,"label":"Electives","notes":"Select three courses (12 units) from the following list of courses or ranges (187 courses are 2 units each; no more than 8 units may be from the 187 series):"},{"type":"all","items":[{"type":"course","code":"SLAVC 191TA","status":"inactive"},{"type":"course","code":"SLAVC 191TB","status":"inactive"},{"type":"course","code":"SLAVC 191TC","status":"inactive"}],"label":"Capstone","notes":"During their senior year, students must also take the following courses in which they complete a capstone senior thesis:"}],"label":"The Major"}},{"name":"Honors Program","requirement":{"type":"all","items":[{"type":"course","code":"SLAVC 198A","status":"inactive"},{"type":"course","code":"SLAVC 198B","status":"inactive"},{"type":"course","code":"SLAVC 198C","status":"inactive"}],"label":"Honors Program","notes":"The honors program is designed for exceptional departmental majors who wish to complete a research project that culminates in an honors thesis. The courses must be taken during senior year (fall, winter, and spring terms respectively). Students pursuing departmental honors must submit the contract for each course by the end of the tenth week of the previous quarter. The sequence culminates in the submission of a thesis. Students who enroll in the honors program are exempt from taking the standard thesis course sequence (Slavic 191TA, 191TB, 191TC)."}},{"name":"Preparation for the Major","requirement":{"type":"choose","items":[{"type":"course","code":"C&EE ST 91","status":"active"},{"type":"course","code":"SLAVC 90","status":"inactive"}],"count":1,"label":"Preparation for the Major","notes":"Select one course from:"}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"C&EE ST 91","title":"Culture and Society in Central and Eastern Europe","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Interdisciplinary introduction to main themes and concepts of Central and East European studies, including historical background, nation states and ethnic groups, and languages spoken in area. Focus on politics, society, and culture in communist and early post-communist periods: party control and dissidence; national economic planning and private entrepreneurship; atheist education and state religion; politically engaged literature, mass media, and freedom of expression; sports, visual and performing arts, and nationalism. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CEEST91"},{"id":"C&EE ST CM126","title":"Cold-War Central European Culture","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"(Formerly numbered C126.) (Same as European Languages and Transcultural Studies CM126.) Lecture, three hours. Examination of cold-war Central European culture through prism of prose fiction, essays, and film from 1947 to 1989. Analysis of strategies of Polish, Czech, Hungarian, and East German writers as articulation of tensions, contradictions, and compromises informing communist rule in central and eastern Europe, with focus on culture as node of resistance as well as accommodation to communist system. Concurrently scheduled with course CM226. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CEESTCM126"},{"id":"C&EE ST M120","title":"Women and Literature in Southeastern Europe","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"(Same as Comparative Literature M120.) Seminar, three hours. Examination of changing roles of women in Balkan countries (Albania, Bosnia-Herzegovina, Bulgaria, Croatia, Greece, Macedonia, Montenegro, Romania, Serbia, Slovenia, Turkey) in last forty years. Emphasis on cultural, social, political, and economic factors affecting women’s roles during countries’ transition from agricultural to industrial economy and from communism to post-communism (in former communist countries). Sensitizes students to complexity of issues in region and helps them better understand multiplicity of causes of present situation. Interdisciplinary study, drawing on sociological/women’s studies, articles, and short fiction by women writers for analysis. Discussion of topics covered in articles, positions taken by authors, and ways in which aspects of Southeast European realities are rendered in fictional form by women writers from region. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CEESTM120"},{"id":"C&EE ST M125","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"elective","groups":["The Major: Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"CZCH 101A","title":"Introduction to Czech Language and Culture","units":"5","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Introductory Language Sequence"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, five hours. Course 101A is recommended preparation for 101B, which is recommended preparation for 101C. Each course may be waived with consent of instructor. Beginning Czech language course with strong cultural component. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CZCH101A"},{"id":"CZCH 101B","title":"Introduction to Czech Language and Culture","units":"5","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Introductory Language Sequence"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, five hours. Beginning Czech language course with strong cultural component. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CZCH101B"},{"id":"CZCH 101C","title":"Introduction to Czech Language and Culture","units":"5","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Introductory Language Sequence"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, five hours. B