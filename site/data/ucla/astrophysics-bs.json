ourse","code":"COMPTNG 10A","status":"active"}],"count":1,"label":"Programming","notes":"Select one course from following list or demonstrate ability to program:"},{"type":"all","items":[{"type":"course","code":"CHEM 20A","status":"active"}],"label":"Recommended","notes":"The following course is recommended:"}],"label":"Preparation for the Major"}},{"name":"The Major","requirement":{"type":"all","items":[{"type":"all","items":[{"type":"course","code":"ASTR 115","status":"active"},{"type":"course","code":"ASTR 117","status":"active"},{"type":"course","code":"ASTR 127","status":"active"},{"type":"course","code":"ASTR 180","status":"active"}],"label":"Astronomy"},{"type":"all","items":[{"type":"course","code":"PHYSICS 105A","status":"inactive"},{"type":"course","code":"PHYSICS 105B","status":"inactive"},{"type":"course","code":"PHYSICS 110A","status":"inactive"},{"type":"course","code":"PHYSICS 110B","status":"inactive"},{"type":"course","code":"PHYSICS 115A","status":"inactive"},{"type":"course","code":"PHYSICS 115B","status":"inactive"},{"type":"course","code":"PHYSICS 115C","status":"inactive"}],"label":"Physics"},{"type":"choose","items":[{"type":"course","code":"ASTR 140","status":"active"},{"type":"course","code":"ASTR 141","status":"active"},{"type":"course","code":"ASTR 142","status":"active"},{"type":"course","code":"ASTR 143","status":"active"},{"type":"course","code":"ASTR 144","status":"active"},{"type":"course","code":"ASTR 145","status":"active"},{"type":"course","code":"ASTR 146","status":"active"},{"type":"course","code":"EPS SCI 155","status":"inactive"},{"type":"course","code":"EPS SCI C179","status":"inactive"},{"type":"course","code":"PHYSICS 108","status":"inactive"},{"type":"course","code":"PHYSICS M122","status":"inactive"},{"type":"course","code":"PHYSICS 124","status":"inactive"},{"type":"course","code":"PHYSICS 126","status":"inactive"},{"type":"course","code":"PHYSICS 127","status":"inactive"},{"type":"course","code":"PHYSICS 128","status":"inactive"},{"type":"course","code":"PHYSICS 132","status":"inactive"},{"type":"course","code":"PHYSICS C170M","status":"inactive"}],"count":3,"label":"Electives","notes":"Select three additional upper-division courses, with at least one course in astronomy, from the following:"}],"label":"The Major"}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"ASTR 81","title":"Fundamentals of Astrophysics","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major: Astronomy"],"column":1,"prereq_text":"Mathematics 31A, 31B, and Physics 1A or 1AH","requires":{"type":"and","items":[{"type":"course","code":"MATH 31A","concurrent":false,"min_grade":null},{"type":"course","code":"MATH 31B","concurrent":false,"min_grade":null},{"type":"or","items":[{"type":"course","code":"PHYSICS 1A","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 1AH","concurrent":false,"min_grade":null}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Open to qualified sophomore and upper-division students. Students develop understanding of fundamental physical concepts such as gravity and radiation, and how these concepts connect to stars and planets. Overview of stars and stellar evolution, and tools and methods important to astrophysics such as telescopes and spectroscopy. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR81"},{"id":"ASTR 115","title":"Introduction to Galactic Astronomy","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Astronomy"],"column":2,"prereq_text":"course 81, Mathematics 31A, 31B, and Physics 1A or 1AH","requires":{"type":"and","items":[{"type":"course","code":"ASTR 81","concurrent":false,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":false,"min_grade":null},{"type":"course","code":"MATH 31B","concurrent":false,"min_grade":null},{"type":"or","items":[{"type":"course","code":"PHYSICS 1A","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 1AH","concurrent":false,"min_grade":null}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Open to qualified sophomore and upper-division students. Introduction of principles important for understanding components and evolution of Milky Way galaxy. Topics include interstellar medium, star and planet formation, and exoplanets. Examination of basic physical processes governing compact stellar remnants such as white dwarfs, neutron stars, and black holes. Overview of structure and properties of Milky Way galaxy. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR115"},{"id":"ASTR 117","title":"Introduction to Extragalactic Astrophysics","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Astronomy"],"column":3,"prereq_text":"courses 81, 115, Mathematics 31A, 31B, and Physics 1A or 1AH","requires":{"type":"and","items":[{"type":"course","code":"ASTR 81","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 115","concurrent":false,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":false,"min_grade":null},{"type":"course","code":"MATH 31B","concurrent":false,"min_grade":null},{"type":"or","items":[{"type":"course","code":"PHYSICS 1A","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 1AH","concurrent":false,"min_grade":null}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Open to qualified sophomore and upper-division students. Introduction to formation and evolution of universe from Big Bang to structure formation and galaxy evolution. Development of physics behind our modern understanding of universe on large scales. Including role of dark matter and dark energy. Introduction of energetic phenomena such as active galactic nuclei and quasars. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR117"},{"id":"ASTR 127","title":"Stars from Birth to Death","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Astronomy"],"column":4,"prereq_text":"courses 81, 115, 117","requires":{"type":"and","items":[{"type":"course","code":"ASTR 81","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 115","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 117","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. In-depth exploration into lives and deaths of stars. Covers production of energy and physics of stellar interiors and atmospheres. Topics include star formation, variability and evolution. Includes significant exploration of nuclear physics and advanced stages of fusion. Covers properties and formation of stellar remnants from white dwarfs to black holes. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR127"},{"id":"ASTR 140","title":"Galaxies","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":4,"prereq_text":"courses 115, 117","requires":{"type":"and","items":[{"type":"course","code":"ASTR 115","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 117","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Designed for upper-division Astrophysics and Physics majors. Focus on basic unit of structure in universe: galaxies. Consideration of physics governing their structure and evolution, and how galaxy population has evolved over history of universe. Other topics include Milky Way, stellar dynamics, active galactic nuclei, and galaxy clusters. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR140"},{"id":"ASTR 141","title":"Cosmology","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":4,"prereq_text":"courses 115, 117","requires":{"type":"and","items":[{"type":"course","code":"ASTR 115","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 117","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Designed for upper-division Astrophysics and Physics majors. In-depth exploration of Big Bang model for universe. Examination of what expanding universe is, how cosmologists measure its properties, and how universe has changed since Big Bang. Topics include cosmic expansion, dark matter, inflation, cosmic microwave background, Big Bang nucleosynthesis, and structure formation. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR141"},{"id":"ASTR 142","title":"Data and Computation in Astrophysics","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":4,"prereq_text":"courses 81, 115, 117, and Computer Science 30 or 31 or Program in Computing 10A","requires":{"type":"and","items":[{"type":"course","code":"ASTR 81","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 115","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 117","concurrent":false,"min_grade":null},{"type":"or","items":[{"type":"course","code":"COM SCI 30","concurrent":false,"min_grade":null},{"type":"course","code":"COM SCI 31","concurrent":false,"min_grade":null},{"type":"course","code":"COMPTNG 10A","concurrent":false,"min_grade":null}]}]},"ambiguous":false,"description":"Lecture, two hours; discussion, four hours. Designed for upper-division Astrophysics and Physics majors. Project-based introduction to data and computation in astrophysics context. Students develop core computational toolkit for data retrieval, processing, analysis, visualization, and interpretation. Topics include analysis of large, heterogeneous datasets; high-performance computation; numerical simulations; and scientific numerical methods. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR142"},{"id":"ASTR 143","title":"Planets and Exoplanets","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":3,"prereq_text":"course 81, Physics 105A","requires":{"type":"and","items":[{"type":"course","code":"ASTR 81","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 105A","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Designed for upper-division Astrophysics and Physics majors. Focus on detection and characterization of planets orbiting other stars, and on physical processes that determine their formation, structure, and evolution. Topics of discussion include broader astrophysical context of planet formation and how observations of solar system properties can be incorporated into emerging understanding of extrasolar planetary systems. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR143"},{"id":"ASTR 144","title":"Star Formation and Interstellar Medium","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":4,"prereq_text":"courses 81, 115, 117","requires":{"type":"and","items":[{"type":"course","code":"ASTR 81","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 115","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 117","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Designed for upper-division Astrophysics and Physics majors. Focus on key components of interstellar medium (ISM) in galaxies, including dust, and neutral, ionized, and molecular gas. Consideration of dynamical processes, such as shocks and expanding supernova remnants. Covers process of star formation. Key ISM observational techniques are presented. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR144"},{"id":"ASTR 145","title":"High-Energy Astrophysics","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":3,"prereq_text":"Physics 17, 110A, 115A; and (Physics 110B, 115B) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"course","code":"PHYSICS 17","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 110A","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 115A","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 110B","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 115B","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Designed for upper-division Astrophysics and Physics majors. Introduction to high-energy universe, with overview of sources of high energy (X-ray and gamma-ray) emission. Covers importance of energetic particles in galaxy and connection of high-energy astronomy to cosmology and particle physics. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR145"},{"id":"ASTR 146","title":"Astronomical Instrumentation","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":4,"prereq_text":"courses 81, 115, 117","requires":{"type":"and","items":[{"type":"course","code":"ASTR 81","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 115","concurrent":false,"min_grade":null},{"type":"course","code":"ASTR 117","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Designed for upper-division Astrophysics and Physics majors. Focus on modern observational techniques for astronomy. Topics include optical and infrared techniques including telescope design, charge-coupled devices, and infrared detectors. These also include adaptive optics systems and high contrast detection methods. Covers all other electromagnetic windows from radio waves to gamma rays. Other topics include neutrino, dark matter, and gravitational wave detection. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR146"},{"id":"ASTR 180","title":"Astrophysics Laboratory","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Astronomy"],"column":2,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, two hours; laboratory, four hours. Designed for juniors/seniors in astrophysics, physics, or related field. Topics include statistical methods in astrophysics, instrumentation, data reduction, and optics. Laboratory experiments include observations of sun, stars, and other astronomical objects. Emphasis on use of computers for making measurements from two-dimensional astronomical images. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR180"},{"id":"ASTR 199","title":"Directed Research or Senior Project in Astronomy","units":"2-4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["Honors Program"],"column":2,"prereq_text":"","requires":null,"ambiguous":false,"description":"Tutorial, two hours. Limited to junior/senior Astrophysics and Physics majors. Supervised individual research or investigation under guidance of faculty mentor. Culminating paper required. May be repeated for credit. Individual contract required. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASTR199"},{"id":"CHEM 20A","title":"Chemical Structure","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major: Recommended"],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Mathematics 31A) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 14A. First term of general chemistry. Survey of chemical processes, quantum chemistry, atomic and molecular structure and bonding, molecular spectroscopy. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20A"},{"id":"COM SCI 30","title":"Principles and Practices of Computing","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major: Programming"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Designed for students who do not have prior programming experience. Teaches students how to use computers as tool for problem solving, creativity, and exploration through design and implementation of computer programs. Key topics are data types including integers, strings, and lists; control structures, including conditionals and loops; and functional decomposition. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI30"},{"id":"COM SCI 31","title":"Introduction to Computer Science I","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major: Programming"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Introduction to computer science via theory, applications, and programming. Basic data types, operators and control structures. Input/output. Procedural and data abstraction. Introduction to object-oriented software development. Functions, recursion. Arrays, strings, pointers. Abstract data types, object-oriented programming. Examples and exercises from computer science theory and applications. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI31"},{"id":"COMPTNG 10A","title":"Introduction to Programming","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major: Programming"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, two hours; laboratory, eight hours. No prior programming experience assumed. Basic principles of programming, using C&plus;&plus;; algorithmic, procedural problem solving; program design and development; basic data types, control structures and functions; functional arrays and pointers; introduction to classes for programmer-defined data types. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMPTNG10A"},{"id":"EPS SCI 155","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":2,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"EPS SCI C179","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"elective","groups":["The Major: Electives"],"column":2,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"MATH 31A","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["Preparation for the Major: Mathematics"],"column":0,"prereq_text":"","requires":null,"ambi