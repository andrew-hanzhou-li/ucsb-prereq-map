"code":"LBR STD 195B","status":"inactive"},{"type":"course","code":"LBR STD 196","status":"inactive"},{"type":"course","code":"LBR STD 199","status":"inactive"}],"label":"Labor Studies"},{"type":"all","items":[{"type":"course","code":"AF AMER CM113XP","status":"active"},{"type":"course","code":"ASIA AM 113","status":"active"},{"type":"course","code":"ECON 150","status":"inactive"},{"type":"course","code":"ECON 151","status":"inactive"},{"type":"course","code":"GENDER 102","status":"inactive"},{"type":"course","code":"GENDER M137E","status":"inactive"},{"type":"course","code":"GENDER M163","status":"inactive"},{"type":"course","code":"HIST 141B","status":"inactive"},{"type":"course","code":"HIST 146A","status":"inactive"},{"type":"course","code":"HIST 146C","status":"inactive"},{"type":"course","code":"HIST M150C","status":"inactive"},{"type":"course","code":"POL SCI 116A","status":"inactive"},{"type":"course","code":"SOCIOL 157","status":"inactive"},{"type":"course","code":"SOCIOL M163","status":"inactive"},{"type":"course","code":"SOCIOL 171","status":"inactive"},{"type":"course","code":"SOCIOL 173","status":"inactive"}],"label":"Additional Electives"}],"label":"Electives"},{"type":"all","items":[{"type":"course","code":"LBR STD 191","status":"inactive"},{"type":"course","code":"LBR STD 194A","status":"inactive"},{"type":"course","code":"LBR STD 194B","status":"inactive"},{"type":"course","code":"LBR STD 199","status":"inactive"}],"label":"Capstone Research and/or Community-Engaged/Internship Experience","notes":"Senior Labor Studies majors culminate their programs with a research-intensive capstone course. Students may fulfill the requirement by selecting one of the following capstone courses (4 units):"}],"label":"The Major"}},{"name":"Honors Program","requirement":{"type":"all","items":[{"type":"all","items":[{"type":"course","code":"LBR STD 194A","status":"inactive"},{"type":"course","code":"LBR STD 194B","status":"inactive"}],"label":"Labor Summer Research Program"},{"type":"all","items":[{"type":"course","code":"LBR STD 198A","status":"inactive"},{"type":"course","code":"LBR STD 198B","status":"inactive"}],"label":"Honors Research"}],"label":"Honors Program","notes":"The honors program is designed to support exceptional students in conducting original, individual-based research with an academic or public contribution under the close mentorship of a faculty member. Complete one of the following pathways:"}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"AF AMER 1","title":"Introduction to Black Studies","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Lower-Division Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Introduction of methods, theories, conceptual frameworks, and key debates in black studies. Interrogation of how race structures notions of identity and meaning of blackness in relation to class, gender, and sexuality; essential role of African people in development of capitalism, liberalism, and democracy; what various disciplinary lenses and epistemologies (history, literature, sociology, geography, cultural studies, political theory, philosophy, etc.) reveal about experiences of black people in modern world. Key thinkers and ideas from across humanities and social sciences are highlighted. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/AFAMER1"},{"id":"AF AMER CM113XP","title":"Narratives of Justice: Disrupting School-to-Prison Pipeline—Arts, Activism, and Agency","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Additional Electives"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"(Same as Education CM125XP.) Lecture, four hours; discussion, one hour. Exploration of policies and practices, art and activism, and other forms of agency engaging school-to-prison pipeline. Concurrently scheduled with course CM213XP. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/AFAMERCM113XP"},{"id":"AF AMER M5","title":"Social Organization of Black Communities","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Lower-Division Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"(Same as Sociology M5.) Lecture, four hours; discussion, one hour; field trips. Analysis and interpretation of social organization of black communities, with focus on origins and development of black communities, competing theories and research findings, defining characteristics and contemporary issues. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/AFAMERM5"},{"id":"ASIA AM 10","title":"History of Asian Americans","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Lower-Division Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Not open for credit to students with credit for course 10W. Multidisciplinary examination of history of Asians and Pacific Islanders in U.S. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASIAAM10"},{"id":"ASIA AM 20","title":"Contemporary Asian American Communities","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Lower-Division Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Multidisciplinary introduction to contemporary Asian American populations and communities in U.S. Topics include contemporary immigration, demographic trends, sociocultural, economic, and political issues, and interethnic relations. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASIAAM20"},{"id":"ASIA AM 40","title":"Asian American Movement","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Lower-Division Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Using Asian American movement of late 1960s and 1970s as lens, introduction to social history methods, including role of oral history, documentary films, and archival history, and analysis of primary and secondary sources. Asian American movement situated within larger frame of social change of era and interpretation of nation and society through lives of ordinary men and women. Exploration of campus- and community-based activism, service learning, and civic engagement. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASIAAM40"},{"id":"ASIA AM 50","title":"Asian American Women","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Lower-Division Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Overview of history of feminist theory and intersection of gender, class, race/ethnicity from cross-cultural perspectives, with focus on Asian American women’s lived experiences in U.S. Topics include Asian American women’s roles in family life, work, community organization, social change, and cultural creativity. Examination of broader structural forces that affect women in society, such as racialization, immigration, global capitalism, colonialism and postcolonialism, and social movements. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASIAAM50"},{"id":"ASIA AM 113","title":"Asian Americans and Law","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Additional Electives"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, four hours. Introduction to Asian American political identity and critical race theory—study of race and representation in making of modern American law and legal meaning. Survey of federal cases, legislation, and regulations pertaining to race, gender, and sexuality in Asian American community formations and relationality towards communities of color and indigenous communities, and making of nation-state. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ASIAAM113"},{"id":"CCAS 10B","title":"Introduction to Chicana/Chicano Studies: Social Structure and Contemporary Conditions","units":"5","offered":[],"level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major: Lower-Division Courses"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Multidisciplinary examination of representation, ideologies, and material conditions of Chicanas/Chicanos, including colonialism, race, labor, immigration, poverty, assimilation, and patriarchy. Emphasis on critical reading and writing skills. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CCAS10B"},{"id":"ECON 150","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["The Major: Additional Electives"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"ECON 151","title":"","units":"","offered":[],"level":"","status":"inactive","in_major":true,"role":"required","groups":["The Major: Additional Electives"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"GENDER 10","title":"","units":"","offered":[],"level":"","status":"inactive","in_major"