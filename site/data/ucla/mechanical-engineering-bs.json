nactive"},{"type":"course","code":"MECH&AE C171B","status":"inactive"},{"type":"course","code":"MECH&AE 172","status":"inactive"},{"type":"course","code":"MECH&AE 174","status":"inactive"},{"type":"course","code":"MECH&AE C175A","status":"inactive"},{"type":"course","code":"MECH&AE 181A","status":"inactive"},{"type":"course","code":"MECH&AE 182B","status":"inactive"},{"type":"course","code":"MECH&AE 182C","status":"inactive"},{"type":"course","code":"MECH&AE 183A","status":"inactive"},{"type":"course","code":"MECH&AE M183B","status":"inactive"},{"type":"course","code":"MECH&AE C183C","status":"inactive"},{"type":"course","code":"MECH&AE 185","status":"inactive"},{"type":"course","code":"MECH&AE C186","status":"inactive"},{"type":"course","code":"MECH&AE C187L","status":"inactive"}],"count":2,"label":"Major Field Electives","notes":"Select two major field elective courses (8 units) from the following list. Courses applied as a required course may not be applied."}],"label":"The Major"}},{"name":"Preparation for the Major","requirement":{"type":"all","items":[{"type":"course","code":"CHEM 20A","status":"active"},{"type":"course","code":"CHEM 20B","status":"active"},{"type":"course","code":"CHEM 20L","status":"active"},{"type":"course","code":"MATH 31A","status":"inactive"},{"type":"course","code":"MATH 31B","status":"inactive"},{"type":"course","code":"MATH 32A","status":"inactive"},{"type":"course","code":"MATH 32B","status":"inactive"},{"type":"course","code":"MATH 33A","status":"inactive"},{"type":"course","code":"MECH&AE 82","status":"inactive"},{"type":"course","code":"MECH&AE 94","status":"inactive"},{"type":"course","code":"PHYSICS 1A","status":"inactive"},{"type":"course","code":"PHYSICS 1B","status":"inactive"},{"type":"course","code":"PHYSICS 1C","status":"inactive"},{"type":"course","code":"PHYSICS 4AL","status":"inactive"},{"type":"course","code":"PHYSICS 4BL","status":"inactive"},{"type":"choose","items":[{"type":"course","code":"COM SCI 31","status":"active"},{"type":"course","code":"MECH&AE M20","status":"inactive"},{"type":"course","code":"MECH&AE M20P","status":"inactive"}],"count":1,"label":"Mechanical and Aerospace Engineering M20 or 20P or Computer Science 31","notes":"Select one course from:"}],"label":"Preparation for the Major"}}],"narrative":[],"overrides_applied":[]},"nodes":[{"id":"CHEM 14A","title":"General Chemistry for Life Scientists I","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Life Sciences 30A or Mathematics 3A or 31A or score of 48 or better on Mathematics Diagnostic Test) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 3A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},{"type":"condition","kind":"other","text":"score of 48"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 20A. Introduction to physical and general chemistry principles; atomic structure based on quantum mechanics; atomic properties; trends in periodic table; chemical bonding (Lewis structures, VSEPR theory, hybridization, and molecular orbital theory); coordination compounds; properties of inorganic and organic acids, bases, buffers. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14A"},{"id":"CHEM 14AE","title":"General Chemistry for Life Scientists I—Enhanced","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Life Sciences 30A or Mathematics 3A or 31A or score of 48 or better on Mathematics Diagnostic Test) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 3A","concurrent":true,"min_grade":null},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},{"type":"condition","kind":"other","text":"score of 48"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, two hours. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 14A or 20A. Study of foundations of chemistry. Discussion of foundations of quantum mechanics and how these principles can be used to understand atomic and molecular structure and properties; how molecules interact; and properties of inorganic, organic, and biological acids, bases, and salts. Biological, environmental, and socially-relevant examples are used to illustrate central role that chemistry plays in our world. Emphasis on developing problem-solving skills and collaborative interaction and learning. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14AE"},{"id":"CHEM 14B","title":"General Chemistry for Life Scientists II","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"one course from 14A, 14AE, 20A, or 20AH with grade of C– or better; and (Life Sciences 30B or Mathematics 3B or 31B with grade of C– or better) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"one course from 14A"},{"type":"or","items":[{"type":"course","code":"LIFESCI 30B","concurrent":true,"min_grade":"C-"},{"type":"course","code":"MATH 3B","concurrent":true,"min_grade":"C-"},{"type":"course","code":"MATH 31B","concurrent":true,"min_grade":"C-"}]}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Enforced requisite or Not open to students with credit for course 14BE, 20B, or 20BH. Chemical equilibria in gases and liquids, acid-base equilibrium; phase changes; thermochemistry; first, second, and third laws of thermodynamics; free energy changes; electrochemistry and its role as energy source; chemical kinetics, including catalysis, and reaction mechanisms. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM14B"},{"id":"CHEM 20A","title":"Chemical Structure","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"completion of Chemistry Diagnostic Test; and (Mathematics 31A) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"condition","kind":"other","text":"completion of Chemistry Diagnostic Test"},{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background and three and one half years of high school mathematics. Not open to students with credit for course 14A. First term of general chemistry. Survey of chemical processes, quantum chemistry, atomic and molecular structure and bonding, molecular spectroscopy. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20A"},{"id":"CHEM 20AH","title":"Chemical Structure (Honors)","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"(Mathematics 31A) (may be taken concurrently)","requires":{"type":"course","code":"MATH 31A","concurrent":true,"min_grade":null},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Preparation: high school chemistry or equivalent background, high school physics, and three and one half years of high school mathematics. Honors course parallel to course 20A. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20AH"},{"id":"CHEM 20B","title":"Chemical Energetics and Change","units":"4","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"course 14A or 14AE or 20A or 20AH, and Mathematics 31A, with grades of C– or better; and (Mathematics 31B) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"CHEM 14A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 14AE","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20AH","concurrent":false,"min_grade":"C-"}]},{"type":"course","code":"MATH 31A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"MATH 31B","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour. Second term of general chemistry. Intermolecular forces and organization, phase behavior, chemical thermodynamics, solutions, equilibria, reaction rates and laws. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20B"},{"id":"CHEM 20L","title":"General Chemistry Laboratory","units":"3","offered":[],"level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"course 14A or 20A with grade of C– or better; and (course 14B or 20B) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"CHEM 14A","concurrent":false,"min_grade":"C-"},{"type":"course","code":"CHEM 20A","concurrent":false,"min_grade":"C-"}]},{"type":"or","items":[{"type":"course","code":"CHEM 14B","concurrent":true,"min_grade":null},{"type":"course","code":"CHEM 20B","concurrent":true,"min_grade":null}]}]},"ambiguous":false,"description":"Lecture, one hour; laboratory, three hours. Use of balance, volumetric techniques, volumetric and potentiometric analysis; Beer’s law, applications for environmental analysis and materials science. P/NP or letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/CHEM20L"},{"id":"COM SCI 1","title":"Freshman Computer Science Seminar","units":"1","offered":["Fall"],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Seminar, one hour. Introduction to department resources and principal topics and key ideas in computer science and computer engineering. Students create critical summaries of seminar talks. P/NP grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI1"},{"id":"COM SCI 31","title":"Introduction to Computer Science I","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major: Mechanical and Aerospace Engineering M20 or 20P or Computer Science 31"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Lecture, four hours; discussion, two hours; outside study, six hours. Introduction to computer science via theory, applications, and programming. Basic data types, operators and control structures. Input/output. Procedural and data abstraction. Introduction to object-oriented software development. Functions, recursion. Arrays, strings, pointers. Abstract data types, object-oriented programming. Examples and exercises from computer science theory and applications. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCI31"},{"id":"COM SCI 102","title":"","units":"","offered":[],"level":"","status":"not_in_catalog","in_major":false,"role":"prerequisite","groups":[],"column":1,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"COM SCI M51A","title":"Logic Design of Digital Systems","units":"4","offered":["Fall"],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"(Same as Electrical and Computer Engineering M16.) Lecture, four hours; discussion, two hours; outside study, six hours. Introduction to digital systems. Specification and implementation of combinational and sequential systems. Standard logic modules and programmable logic arrays. Specification and implementation of algorithmic systems: data and control sections. Number systems and arithmetic algorithms. Error control codes for digital information. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/COMSCIM51A"},{"id":"EC ENGR 3","title":"","units":"","offered":[],"level":"","status":"not_in_catalog","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"EC ENGR 10","title":"Circuit Theory I","units":"4","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":95,"prereq_text":"course 3 (or Computer Science 1 or Materials Science 10), Mathematics 33A, Physics 1B; and (course 11L (enforced), Mathematics 33B) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"or","items":[{"type":"course","code":"EC ENGR 3","concurrent":false,"min_grade":null},{"type":"course","code":"COM SCI 1","concurrent":false,"min_grade":null},{"type":"condition","kind":"other","text":"Materials Science 10"}]},{"type":"course","code":"MATH 33A","concurrent":false,"min_grade":null},{"type":"course","code":"PHYSICS 1B","concurrent":false,"min_grade":null},{"type":"course","code":"EC ENGR 11L","concurrent":false,"min_grade":null},{"type":"course","code":"MATH 33B","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, four hours; discussion, one hour; outside study, seven hours. Introduction to linear circuit analysis. Resistive circuits, capacitors, inductors and ideal transformers, Kirchhoff laws, node and loop analysis, first-order circuits, second-order circuits, Thevenin and Norton theorem, sinusoidal steady state. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ECENGR10"},{"id":"EC ENGR 11L","title":"Circuits Laboratory I","units":"1","offered":[],"level":"lower","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":95,"prereq_text":"(course 10) (may be taken concurrently)","requires":{"type":"course","code":"EC ENGR 10","concurrent":true,"min_grade":null},"ambiguous":false,"description":"Lecture, one hour; laboratory, one hour; outside study, one hour. Experiments with basic circuits containing resistors, capacitors, inductors, and transformers. Ohm’s law voltage and current division, Thevenin and Norton equivalent circuits, superposition, transient and steady state analysis. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ECENGR11L"},{"id":"EC ENGR 100","title":"Electrical and Electronic Circuits","units":"4","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Departmental Breadth Courses"],"column":1,"prereq_text":"Mathematics 33A, 33B or Mechanical and Aerospace Engineering 82, Physics 1C","requires":{"type":"and","items":[{"type":"course","code":"MATH 33A","concurrent":false,"min_grade":null},{"type":"or","items":[{"type":"course","code":"MATH 33B","concurrent":false,"min_grade":null},{"type":"course","code":"MECH&AE 82","concurrent":false,"min_grade":null}]},{"type":"course","code":"PHYSICS 1C","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour; outside study, eight hours. Not open for credit to students with credit for course 110. Electrical quantities, linear circuit elements, circuit principles, signal waveforms, transient and steady state circuit behavior, semiconductor diodes and transistors, small signal models, and operational amplifiers. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ECENGR100"},{"id":"EC ENGR 110","title":"Circuit Theory II","units":"4","offered":[],"level":"upper","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":96,"prereq_text":"courses 10, M16 (or Computer Science M51A), 102; and (course 111L (enforced only for Computer Science and Engineering and Electrical Engineering majors)) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"course","code":"EC ENGR 10","concurrent":false,"min_grade":null},{"type":"or","items":[{"type":"course","code":"EC ENGR M16","concurrent":false,"min_grade":null},{"type":"course","code":"COM SCI M51A","concurrent":false,"min_grade":null}]},{"type":"course","code":"COM SCI 102","concurrent":false,"min_grade":null},{"type":"condition","kind":"other","text":"enforced only for Computer Science"},{"type":"course","code":"EC ENGR 111L","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, three hours; discussion, one hour; outside study, eight hours. Sinusoidal excitation and phasors, AC steady state analysis, AC steady state power, network functions, poles and zeros, frequency response, mutual inductance, ideal transformer, application of Laplace transforms to circuit analysis. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ECENGR110"},{"id":"EC ENGR 110L","title":"Circuit Measurements Laboratory","units":"2","offered":[],"level":"upper","status":"active","in_major":true,"role":"required","groups":["The Major: Required Courses"],"column":2,"prereq_text":"course 100 or 110","requires":{"type":"or","items":[{"type":"course","code":"EC ENGR 100","concurrent":false,"min_grade":null},{"type":"course","code":"EC ENGR 110","concurrent":false,"min_grade":null}]},"ambiguous":false,"description":"Laboratory, four hours; outside study, two hours. Experiments with basic circuits containing resistors, capacitors, inductors, and op-amps. Ohm’s law voltage and current division, Thevenin and Norton equivalent circuits, superposition, transient and steady state analysis, and frequency response principles. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ECENGR110L"},{"id":"EC ENGR 111L","title":"Circuits Laboratory II","units":"1","offered":[],"level":"upper","status":"active","in_major":false,"role":"prerequisite","groups":[],"column":96,"prereq_text":"courses 10, 11L; and (course 110) (may be taken concurrently)","requires":{"type":"and","items":[{"type":"course","code":"EC ENGR 10","concurrent":false,"min_grade":null},{"type":"course","code":"EC ENGR 11L","concurrent":false,"min_grade":null},{"type":"course","code":"EC ENGR 110","concurrent":true,"min_grade":null}]},"ambiguous":false,"description":"Lecture, one hour; laboratory, one hour; outside study, one hour. Experiments with electrical circuits containing resistors, capacitors, inductors, transformers, and op-amps. Steady state power analysis, frequency response principles, op-amp-based circuit synthesis, and two-port network principles. Letter grading.","url":"https://catalog.registrar.ucla.edu/course/2026/ECENGR111L"},{"id":"EC ENGR M16","title":"","units":"","offered":[],"level":"","status":"not_in_catalog","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LIFESCI 30A","title":"","units":"","offered":[],"level":"","status":"not_in_catalog","in_major":false,"role":"prerequisite","groups":[],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"LIFESCI 30B","title":"","units":"","offered":[],"level":"","status":"not_in_catalog","in_major":false,