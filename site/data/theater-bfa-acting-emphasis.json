{"id":"DANCE 42B","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"DANCE 42C","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"DANCE 42D","title":"Continuing Ballet","units":"2","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Further study of basic elements of ballet."},{"id":"DANCE 42E","title":"Continuing Ballet","units":"2","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Further study of basic elements of ballet."},{"id":"DANCE 42F","title":"Continuing Ballet","units":"2","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Further study of basic elements of ballet."},{"id":"DANCE 43A","title":"Beginning Street Dance Forms","units":"2","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Introduction to the various forms of street dance including Hip Hop and Isolations."},{"id":"DANCE 43B","title":"Beginning Street Dance Forms","units":"2","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Introduction to the various forms of street dance including House Dance, Whacking, and Punking."},{"id":"DANCE 43C","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"DANCE 44A","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"DANCE 44B","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"DANCE 44C","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"DANCE 44D","title":"Continuing Modern Dance","units":"2","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Further study of basic elements of modern dance."},{"id":"DANCE 44E","title":"Continuing Modern Dance","units":"2","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Further study of basic elements of modern dance."},{"id":"DANCE 44F","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"DANCE 46","title":"Introduction to Social Dance: History and Practice","units":"2","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"An introductory level survey of Social Dance. Studio-based physical practice will be complimented by a survey of the history, theory and/or literature of Social Dance. A beginning level elective dance course, Intro to Social Dance focuses on forms developing in Europe, North and South America, as well as their migration and development across borders. Course work is grounded in the physical study of multiple styles alongside outside classwork comprised of readings, viewings and collaborative group projects."},{"id":"THTR 1","title":"Play Analysis","units":"5","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Deep study of key concepts used in the analysis of plays in performance, including story, action, genre, liveness, and experience. Includes study of exemplary plays and performances."},{"id":"THTR 2A","title":"Performance in Global Contexts: Africa and the Caribbean","units":"5","level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Introduction to local performance traditions in Africa and the Caribbean, such as storytelling, ritual, and Carnival. The course also examines how African and Caribbean playwrights put those traditions to social and political uses by incorporating them into post-colonial plays."},{"id":"THTR 2B","title":"Performance in Global Contexts: ASIA","units":"5","level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"This course surveys a range of Asian performances across a diversity of locations, from the traditional theater forms of Japanese Kabuki, Indonesian Wayang Kulit, and Indian Kathakali to modern forms in India and Japan to contemporary Chinese performance art. Theater forms like Chinese Jingju and Japanese Noh will prompt us to reevaluate what the performer does in rehearsal and in situations on and off the stage. By exploring recent modern and contemporary performance forms, we will reassess how an actor, dancer, or puppeteer can challenge the status quo and effect change. As we ask these questions, we will situate Asian performance within social, political, and historical contexts to understand its rich functions and significances."},{"id":"THTR 2C","title":"Performance in Global Contexts: EUROPE","units":"5","level":"lower","status":"active","in_major":true,"role":"choice","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Introduction to theater and performance practice and traditions in Europe. Topics will include ritual, the rise of a public theater, the political uses of theater, the development of festival theater, and the uses of performance in non-theatrical contexts."},{"id":"THTR 2D","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"choice","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"THTR 5","title":"Introduction To Acting","units":"3","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"An introduction for majors and nonmajors to the multiple problems of the actor's art and craft."},{"id":"THTR 10A","title":"Movement For The Stage","units":"2","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; audition.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"other","text":"audition"}]},"ambiguous":false,"description":"Intense physical training designed to produce a neutral, dynamic, and expressive bodily instrument."},{"id":"THTR 10B","title":"Movement For The Stage","units":"2","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; audition.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"other","text":"audition"}]},"ambiguous":false,"description":"Intense physical training designed to produce a neutral, dynamic, and expressive bodily instrument."},{"id":"THTR 10C","title":"Movement For The Stage","units":"2","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"Intense physical training designed to produce a neutral, dynamic, and expressive bodily instrument."},{"id":"THTR 11A","title":"Voice Laboratory","units":"2","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"A fundamental approach to voice for the actor with emphasis on vocal production, articulation, and quality; plus physical relaxation techniques."},{"id":"THTR 11B","title":"Voice Laboratory","units":"2","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"A fundamental approach to voice for the actor with emphasis on vocal production, articulation, and quality; plus physical relaxation techniques."},{"id":"THTR 11C","title":"Voice Laboratory","units":"2","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"A fundamental approach to voice for the actor with emphasis on vocal production, articulation, and quality; plus physical relaxation techniques."},{"id":"THTR 15A","title":"Fundamentals of Acting","units":"4","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"Development of the intermediate actor's foundational work in improvisation, technique, scene study, textual analysis, and characterization while exploring creative capacity."},{"id":"THTR 15B","title":"Fundamentals of Acting","units":"4","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"Development of the intermediate actor's foundational work in improvisation, technique, scene study, textual analysis, and characterization while exploring creative capacity."},{"id":"THTR 15C","title":"Fundamentals of Acting","units":"4","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":1,"prereq_text":"Theater 5; consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 5","concurrent":false,"min_grade":null},{"type":"condition","kind":"consent","text":"consent of instructor"}]},"ambiguous":false,"description":"Development of the intermediate actor's foundational work in improvisation, technique, scene study, textual analysis, and characterization while exploring creative capacity."},{"id":"THTR 29A","title":"Scenic Practicum","units":"1","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Empirical understanding of methods of assembly and materials for stage scenery. Shop organization and operation are experienced during the construction process."},{"id":"THTR 29B","title":"Lighting Practicum","units":"1","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Empirical understanding of optical properties of lightin units, available hanging positions and apparatus, lighting control, electrical safety and stage crew organization."},{"id":"THTR 29C","title":"Costume Practicum","units":"1","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Empirical understanding of methods of assembly and materials for stage dress. Costume shop organization and operation are experienced during the construction process."},{"id":"THTR 29D","title":"Run Crew Practicum","units":"1","level":"lower","status":"active","in_major":true,"role":"elective","groups":["Preparation for the Major"],"column":0,"prereq_text":"","requires":null,"ambiguous":false,"description":"Empirical understanding of backstage organization and operation during live performance."},{"id":"THTR 49","title":"Theater Workshop","units":"0","level":"lower","status":"active","in_major":true,"role":"required","groups":["Preparation for the Major"],"column":0,"prereq_text":"Lower-division standing.","requires":{"type":"condition","kind":"standing","text":"Lower-division standing"},"ambiguous":false,"description":"Projects in costume, scenery, lighting, acting, directing."},{"id":"THTR 104A","title":"Playwriting Workshop","units":"4","level":"upper","status":"active","in_major":true,"role":"elective","groups":["Upper-Division Major"],"column":2,"prereq_text":"Consent of instructor.","requires":{"type":"condition","kind":"consent","text":"Consent of instructor"},"ambiguous":false,"description":"An exploration of the essential components of playwriting. Exercises focus on writing dialogue, monologue, creating three-dimensional characters, building effective story structures, and developing action through language and stage images. A series of written assignments."},{"id":"THTR 104B","title":"Advanced Playwriting Workshop","units":"4","level":"upper","status":"active","in_major":true,"role":"elective","groups":["Upper-Division Major"],"column":2,"prereq_text":"Consent of instructor.","requires":{"type":"condition","kind":"consent","text":"Consent of instructor"},"ambiguous":false,"description":"A continued exploration of the essential components of playwriting. Writing exercises in dialogue, monologue, character, story structure, action and stage images. Students focus on developing their individual writing voice. A series of written assignments."},{"id":"THTR 104C","title":"Collaboration & Ensemble Devising","units":"4","level":"upper","status":"active","in_major":true,"role":"elective","groups":["Upper-Division Major"],"column":2,"prereq_text":"Consent of instructor.","requires":{"type":"condition","kind":"consent","text":"Consent of instructor"},"ambiguous":false,"description":"Open to playwrights, dancers, directors, actors, and designers. A series of written and ensemble performance-based assignments in which small groups explore different ways of generating and staging new material."},{"id":"THTR 104D","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Upper-Division Major"],"column":2,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"THTR 104E","title":"","units":"","level":"","status":"inactive","in_major":true,"role":"elective","groups":["Upper-Division Major"],"column":2,"prereq_text":"","requires":null,"ambiguous":false,"description":""},{"id":"THTR 110A","title":"Advanced Movement for the Stage","units":"2","level":"upper","status":"active","in_major":true,"role":"required","groups":["Upper-Division Major"],"column":3,"prereq_text":"Theater 10C; concurrent enrollment in Theater 151A. Consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 10C","concurrent":false,"min_grade":null},{"type":"course","code":"THTR 151A","concurrent":true,"min_grade":null},{"type":"condition","kind":"consent","text":"Consent of instructor"}]},"ambiguous":false,"description":"A continuation of the Theater 10 series with increased focus on physical characterization and technical skills."},{"id":"THTR 110B","title":"Advanced Movement For The Stage","units":"2","level":"upper","status":"active","in_major":true,"role":"required","groups":["Upper-Division Major"],"column":3,"prereq_text":"Concurrent enrollment in Theater 151B. Consent of instructor.","requires":{"type":"and","items":[{"type":"course","code":"THTR 151B","concurrent":true,"min_grade":null},{"type":"condition","kind":"consent","text":"Consent of instructor"}]},"ambiguous":false,"description":"A conti